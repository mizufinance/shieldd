+    }
+    pub fn validate(&self,relation:&Relation,witness:&Witness,eta:[Scalar;2],challenge:&Scalar)->Result<(),Error>{
+        if !relation.check_witness(witness){return Err(Error::Unsatisfied)}
+        for subset in [false,true]{
