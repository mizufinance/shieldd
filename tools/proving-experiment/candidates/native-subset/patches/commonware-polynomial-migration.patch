+fn last_node_uses(circuit: &Circuit<Scalar>, layout: &InputLayout) -> Vec<usize> {
+    let mut last: Vec<usize> = (0..circuit.nodes.len()).collect();
+    for (consumer, operation) in circuit.nodes.iter().enumerate() {
+        let (left, right) = match *operation {
+            CircuitNode::Add(left, right) | CircuitNode::Mul(left, right) => (left, right),
+        };
+        for input in [left, right] {
+            if let CircuitIdx::Node(index) = input { last[index as usize] = consumer; }
+        }
+    }
