+    // Run after all folding/fusion/input links; those passes identify constants by column zero.
+    fn outline_constant(&mut self) -> Result<(), Error> {
+        let copy = self.allocate(ValueSource::One)?;
+        for row in &mut self.rows {
+            for side in [&mut row.squared, &mut row.linear] {
+                if let Some(coefficient) = side.terms.remove(&0) {
+                    side.insert(copy, coefficient);
+                }
+            }
+        }
+        self.rows.push(Row {
+            squared: LinearCombination::coordinate(0)
+                .sub(&LinearCombination::coordinate(copy)),
+            linear: LinearCombination::zero(),
+        });
+        Ok(())
+    }
