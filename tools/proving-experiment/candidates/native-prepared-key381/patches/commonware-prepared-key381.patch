+#[test]
+fn prepared_key_storage_preserves_complete_key_and_encodings() {
+    let p = parameters();
+    let key = &p.proving_key;
+    let bytes = key.encode_prepared();
+    let cfg = (RangeCfg::exact(key.verifying_key().public_input_count()), RangeCfg::exact(key.commitment_keys().len()));
+    let mut input = bytes.as_slice();
+    let decoded = ProvingKey::read_prepared_with_strategy(&mut input, &cfg, &Sequential).unwrap();
+    assert!(input.is_empty());
+    assert_eq!(&decoded, key);
+    assert_eq!(decoded.encode(), key.encode());
+    assert_eq!(decoded.encode_prepared(), bytes);
+    let parallel = commonware_parallel::Rayon::new(std::num::NonZeroUsize::new(2).unwrap()).unwrap();
+    let decoded = ProvingKey::read_prepared_with_strategy(&mut bytes.as_slice(), &cfg, &parallel).unwrap();
+    assert_eq!(&decoded, key);
+    assert_eq!(decoded.verifying_key().encode(), key.verifying_key().encode());
+    assert_eq!(decoded.commitment_keys(), key.commitment_keys());
+    assert!(ProvingKey::read_prepared_with_strategy(&mut key.encode().as_ref(), &cfg, &Sequential).is_err());
+    assert!(ProvingKey::read_with_strategy(&mut bytes.as_slice(), &cfg, &Sequential).is_err());
+}
