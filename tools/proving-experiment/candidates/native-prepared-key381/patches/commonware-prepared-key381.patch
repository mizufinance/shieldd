+#[test]
+fn prepared_key_storage_rejects_malformed_queries_and_dimensions() {
+    use commonware_codec::EncodeSize;
+    let key = &parameters().proving_key;
+    let bytes = key.encode_prepared();
+    let cfg = (RangeCfg::exact(key.verifying_key().public_input_count()), RangeCfg::exact(key.commitment_keys().len()));
+    let reject = |bad: &[u8]| {
+        let mut input = bad;
+        let accepted = ProvingKey::read_prepared_with_strategy(&mut input, &cfg, &Sequential)
+            .is_ok_and(|k| input.is_empty() && k.encode_prepared() == bad);
+        assert!(!accepted);
+    };
+    for len in [0, 7, 8, bytes.len()/2, bytes.len()-1] { reject(&bytes[..len]); }
+    reject(&[bytes.as_slice(), &[0]].concat());
+    let mut marker = bytes.clone(); marker[0] ^= 1; reject(&marker);
+    let mut relation = bytes.clone(); relation[8] ^= 1; reject(&relation);
+    let mut domain = bytes.clone(); domain.splice(72..72+key.verifying_key.domain_size.encode_size(), 1u32.encode().iter().copied()); reject(&domain);
+    let query_size = |count: usize| count.encode_size() + count*96;
+    let count_at = bytes.len() - query_size(key.sigma_quotient.len()) - query_size(key.sigma_a.len()) - query_size(key.sigma_r.len());
+    let point_at = count_at + key.sigma_quotient.len().encode_size();
+    let mut count = bytes.clone(); count[count_at] = 0xff; reject(&count);
+    let mut infinity = [0;96]; infinity[0] = 0x40;
+    let mut off_curve = [0;96]; off_curve[95] = 3;
+    let mut torsion = [0;96]; torsion[95] = 2;
+    let outside_group = (1u8..=64).find_map(|x| {
+        let mut compact = [0;48]; compact[0]=0x80; compact[47]=x;
+        blst::min_pk::PublicKey::deserialize(&compact).ok().filter(|p| p.validate().is_err())
+    }).unwrap().serialize();
+    for point in [infinity, off_curve, torsion, outside_group] {
+        let mut bad=bytes.clone(); bad[point_at..point_at+96].copy_from_slice(&point); reject(&bad);
+    }
+    for flag in [0x20,0x40,0x80] {
+        let mut bad=bytes.clone(); bad[point_at] |= flag; reject(&bad);
+    }
+    let mut field=bytes.clone(); field[point_at..point_at+48].fill(0xff); field[point_at]=0x1f; reject(&field);
+    let indices=key.sigma_witness.iter().enumerate().filter(|(_,p)| **p!=G1::zero()).map(|(i,_)|i as u32).collect::<Vec<_>>();
+    assert!(indices.len()>=2);
+    let index_at=8+key.verifying_key.encode_size()+key.commitment_keys.encode_size()+indices.len().encode_size();
+    let second=index_at+indices[0].encode_size()+96;
+    let mut duplicate=bytes.clone(); duplicate.splice(second..second+indices[1].encode_size(),indices[0].encode().iter().copied()); reject(&duplicate);
+    let mut overflow=bytes.clone(); overflow.splice(index_at..index_at+indices[0].encode_size(),u32::MAX.encode().iter().copied()); reject(&overflow);
+}
