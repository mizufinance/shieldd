+fn source_digest(circuit: &Circuit<Scalar>, layout: &InputLayout) -> Result<[u8; 32], Error> {
+    let mut h = blake3::Hasher::new();
+    h.update(b"SHIELDD_NATIVE_EXPERIMENT_SOURCE_CIRCUIT_V1");
+    h.update(&circuit.witnesses.to_be_bytes());
+    hash_usize(&mut h, circuit.constants.len())?;
+    for c in &circuit.constants {
+        h.update(&c.encode());
+    }
+    hash_usize(&mut h, circuit.nodes.len())?;
+    for node in &circuit.nodes {
+        let (tag, a, b) = match *node {
+            CircuitNode::Add(a, b) => (0u8, a, b),
+            CircuitNode::Mul(a, b) => (1u8, a, b),
+        };
+        h.update(&[tag]);
+        hash_indices(&mut h, &[a, b])?;
+    }
+    hash_usize(&mut h, circuit.assertions.len())?;
+    for &(a, b) in &circuit.assertions {
+        hash_indices(&mut h, &[a, b])?;
+    }
+    hash_indices(&mut h, &layout.public)?;
+    hash_usize(&mut h, layout.blocks.len())?;
+    for block in &layout.blocks {
+        hash_indices(&mut h, block)?;
+    }
+    Ok(*h.finalize().as_bytes())
+}
