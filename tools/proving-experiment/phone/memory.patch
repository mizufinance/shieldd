+fn mapped_witness(original_wires: usize, derived: &[Expression], original: &[Fr]) -> Result<Vec<Fr>> {
+    ensure!(original.len() == original_wires && original.first() == Some(&Fr::ONE), "original wire shape or constant mismatch");
+    let mut values = original.to_vec();
+    values.extend(derived.iter().map(|e| evaluate(e, original).square()));
+    // Arkworks outlines the constant and public statement after witness allocation.
+    values.extend_from_slice(&original[..2]);
+    Ok(values)
+}
+
+impl WitnessMap {
+    pub(crate) fn witness(&self, original: &[Fr]) -> Result<Vec<Fr>> {
+        mapped_witness(self.original_wires, &self.derived, original)
+    }
 }
 
