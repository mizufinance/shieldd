+//! Same-key proof equality across the full logical-witness API after lifetime trimming.
+use crate::{arithmetic, bridge, frontend, lowering, worker};
+use anyhow::{ensure, Result};
+use ark_bls12_377::Fr;
+use ark_std::rand::{rngs::StdRng, SeedableRng};
+use serde::{Deserialize, Serialize};
+use std::{fs, path::{Path, PathBuf}, time::{Instant, SystemTime, UNIX_EPOCH}};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Artifact {path: PathBuf, sha256: String}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Fact {scenario: String, witness: Artifact, statement: String}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Manifest {schema: String, facts: Vec<Fact>, invalid: Artifact}
+#[derive(Serialize)]
+struct Record {scenario: String, proof_sha256: String, same_key_seeded_proof_equal: bool, verified: bool, negatives_rejected: bool, diagnostic_request_ns: u128}
+#[derive(Serialize)]
+struct Complete {schema: &'static str, phase_start_unix_ns: u128, initialization_end_unix_ns: u128, initialization: worker::Initialization, released_compilation_storage_bytes: usize, checked_original_and_lowered_assignments: usize, exact_released_mapping_assignments: usize, invalid_witness_rejected: bool, seeded_reference_proofs_not_benchmark_samples: bool, records: Vec<Record>}
+fn checked(a: &Artifact) -> Result<Vec<u8>> {let b=fs::read(&a.path)?;ensure!(arithmetic::sha(&b)==a.sha256,"fixture changed");Ok(b)}
+fn now() -> u128 {SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos()}
+
+pub(crate) fn run(args: &[String]) -> Result<()> {
+    ensure!(args.len()==8,"lifetime-gate RELATION KEY SOLVER ARTIFACTS PRIVATE_CHILD MANIFEST REFERENCE NEW_OUTPUT");
+    let dir=Path::new(&args[0]);let out=Path::new(&args[7]);ensure!(!out.exists(),"preserve gate evidence");
+    let manifest: Manifest=serde_json::from_slice(&fs::read(&args[5])?)?;
+    let names=["transfer","transfer_unregulated","transfer_flagged","transfer_accumulating","transfer_over_limit_disclosure","transfer_accumulator_continuation"];
+    ensure!(manifest.schema=="shieldd.phone_memory_fixtures.v1" && manifest.facts.iter().map(|f|f.scenario.as_str()).eq(names),"six ordered fixtures");
+    let released_compilation_storage_bytes={
+        let original=crate::relation(dir)?;let lowered=lowering::Lowered::compile(&original);
+        let mut originals=Vec::<Vec<Fr>>::new();let mut expected=Vec::new();
+        for name in names {
+            let solved:crate::Solved=serde_json::from_slice(&fs::read(dir.join(format!("{name}.json")))?)?;
+            let values=bridge::assignment(&solved.assignment,&original,&solved.statement)?;
+            lowered.validate(&values)?;
+            expected.push(lowered.witness(&values)?);originals.push(values);
+        }
+        let released=lowered.compilation_storage_bytes();ensure!(released>0,"no compilation storage released");
+        let mapping=lowered.into_witness_map();
+        for (values,expected) in originals.iter().zip(expected) {ensure!(mapping.witness(values)?==expected,"released mapping differs");}
+        released
+    };
+    let phase_start_unix_ns=now();
+    let (mut api,initialization)=worker::Worker::new(dir,Path::new(&args[1]),Path::new(&args[2]),Path::new(&args[3]))?;
+    let (mut foreign,_)=frontend::Foreign::start(&mut api.prover,Path::new(&args[4]))?;
+    let initialization_end_unix_ns=now();fs::create_dir(out)?;
+    let mut records=Vec::new();
+    for (i,fact) in manifest.facts.iter().enumerate() {
+        let input=checked(&fact.witness)?;let mut rng=StdRng::seed_from_u64(7119+i as u64);
+        let start=Instant::now();
+        let (bytes,statement,_)=api.prove_using(&input,|prover,public,witness|foreign.prove(prover,public,witness,&mut rng))?;
+        let diagnostic_request_ns=start.elapsed().as_nanos();
+        ensure!(statement==fact.statement && bytes.len()==168 && api.verify(&bytes,&statement)?,"full logical API proof");
+        let expected=fs::read(Path::new(&args[6]).join(format!("{}.proof",fact.scenario)))?;
+        ensure!(bytes[40..]==expected,"same-key seeded proof changed");
+        ensure!(!api.verify_other_domain(&bytes,&statement)?,"wrong domain accepted");
+        let mut changed=bytes.clone();changed[90]^=1;
+        let mut trailing=bytes.clone();trailing.push(0);
+        for value in [bytes[..bytes.len()-1].to_vec(),changed,trailing] {ensure!(!api.verify(&value,&statement).unwrap_or(false),"malformed proof accepted");}
+        ensure!(!api.verify(&bytes,&"00".repeat(32)).unwrap_or(false),"changed statement accepted");
+        let record=Record{scenario:fact.scenario.clone(),proof_sha256:arithmetic::sha(&bytes),same_key_seeded_proof_equal:true,verified:true,negatives_rejected:true,diagnostic_request_ns};
+        fs::write(out.join(format!("{}.proof",fact.scenario)),&bytes)?;records.push(record);
+        fs::write(out.join("records.json"),serde_json::to_vec_pretty(&records)?)?;
+        println!("{}: exact seeded proof and full-API negatives passed",fact.scenario);
+    }
+    let invalid=checked(&manifest.invalid)?;let mut rng=StdRng::seed_from_u64(123);
+    ensure!(api.prove_using(&invalid,|prover,public,witness|foreign.prove(prover,public,witness,&mut rng)).is_err(),"invalid witness proved");
+    foreign.close()?;drop(api);
+    fs::write(out.join("complete.json"),serde_json::to_vec_pretty(&Complete{schema:"shieldd.phone_memory_gate.v1",phase_start_unix_ns,initialization_end_unix_ns,initialization,released_compilation_storage_bytes,checked_original_and_lowered_assignments:6,exact_released_mapping_assignments:6,invalid_witness_rejected:true,seeded_reference_proofs_not_benchmark_samples:true,records})?)?;
+    Ok(())
+}
