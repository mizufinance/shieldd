def authorization (rho : Nat → NoteReshapeCanonical.F) :
    AuthorizationContext NoteReshapeCanonical.F :=
  {
    authorizationKey :=
      ⟨Contracts.@@MODULE@@.authAk0 rho,
       Contracts.@@MODULE@@.authAk1 rho⟩
    nullifierKey := Contracts.@@MODULE@@.authNk rho
    ivkReduced := Contracts.@@MODULE@@.authIvkReduced rho
    ivkQuotientA := Contracts.@@MODULE@@.authIvkQuotientA rho
  }

def transmission (rho : Nat → NoteReshapeCanonical.F) :
    Decaf377Assumptions.Point :=
  ⟨Deployed.Templates.Semantics.TDecafCompressToField_@@TRANSMISSION_TEMPLATE@@.inputX
      (Contracts.@@MODULE@@.Seg@@TRANSMISSION_SEG@@.localRho rho),
   Deployed.Templates.Semantics.TDecafCompressToField_@@TRANSMISSION_TEMPLATE@@.inputY
      (Contracts.@@MODULE@@.Seg@@TRANSMISSION_SEG@@.localRho rho)⟩

def divGenFq (rho : Nat → NoteReshapeCanonical.F) : NoteReshapeCanonical.F :=
  Deployed.Templates.Semantics.TDecafCompressToField_@@DIV_TEMPLATE@@.templateRho
      (Contracts.@@MODULE@@.Seg@@DIV_SEG@@.localRho rho) 912 -
    Deployed.Templates.Semantics.TDecafCompressToField_@@DIV_TEMPLATE@@.templateRho
      (Contracts.@@MODULE@@.Seg@@DIV_SEG@@.localRho rho) 572

def transmissionFq (rho : Nat → NoteReshapeCanonical.F) :
    NoteReshapeCanonical.F :=
  Deployed.Templates.Semantics.TDecafCompressToField_@@TRANSMISSION_TEMPLATE@@.templateRho
      (Contracts.@@MODULE@@.Seg@@TRANSMISSION_SEG@@.localRho rho) 912 -
    Deployed.Templates.Semantics.TDecafCompressToField_@@TRANSMISSION_TEMPLATE@@.templateRho
      (Contracts.@@MODULE@@.Seg@@TRANSMISSION_SEG@@.localRho rho) 572

def shared (rho : Nat → NoteReshapeCanonical.F) :
    SharedContext NoteReshapeCanonical.F :=
  {
    assetId := Contracts.@@MODULE@@.sharedAssetId rho
    diversifiedGenerator :=
      ⟨Contracts.@@MODULE@@.sharedDivGen0 rho,
       Contracts.@@MODULE@@.sharedDivGen1 rho⟩
    diversifiedGeneratorEncoding := divGenFq rho
    transmission := NoteReshapeCanonical.toProtocolPoint (transmission rho)
    transmissionEncoding := transmissionFq rho
  }

@@ENCODING_SEAMS@@@@CANONICAL_FACTS@@theorem canonicalTransmission_of_exact
    (rho : Nat → Contracts.@@MODULE@@.DeployedF)
    (facts : Contracts.@@MODULE@@.@@MODULE@@CircuitFacts rho) :
    NoteReshapeCanonical.canonicalTransmission (authorization rho) (shared rho) := by
  rcases canonicalTransmissionFacts_of_exact rho facts with
    ⟨hauthorizationKey, hdiversifiedGenerator, hdiv, hdtk, htransmission⟩
  refine
    ⟨⟨hauthorizationKey, hdiversifiedGenerator, hdiv, hdtk, htransmission⟩,
      ?_, ?_⟩
  · simpa [
      Protocol.Common.Decaf.incomingViewingKeyNonzero,
      authorization
    ] using
      Contracts.@@MODULE@@.authIvkReducedNonzero_of_exact rho facts
  · have h :=
      Contracts.@@MODULE@@.sharedTransmissionComputedNonIdentity_of_exact
        rho facts
    rw [
      Contracts.@@MODULE@@.sharedTransmissionComputed0_eq_dtkOutX,
      Contracts.@@MODULE@@.dtkOutX_eq_transmissionCompressInputX
    ] at h
    simpa [
      Protocol.Common.Decaf.transmissionKeyNonIdentity,
      Protocol.Common.Decaf.nonIdentity,
      shared, NoteReshapeCanonical.toProtocolPoint, transmission
    ] using h

end Shieldd.GnarkFormal.Deployed.NoteReshapeCanonicalAddress@@FAMILY@@
