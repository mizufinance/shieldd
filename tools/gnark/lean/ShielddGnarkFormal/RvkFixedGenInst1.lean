    ∃ b : Bool, x = toZMod b := by
  have hmul : x * (1 - x) = 0 := by linear_combination h
  rcases eq_zero_or_eq_zero_of_mul_eq_zero hmul with h0 | h1
  · exact ⟨false, by rw [Bool.toZMod_zero]; exact h0⟩
  · exact ⟨true, by rw [Bool.toZMod_one]; linear_combination -h1⟩
