import ShielddGnarkFormal.Poseidon2Bridge

/-! Reusable deployed-slice link for width-3 Poseidon permutations. -/

namespace Shieldd.GnarkFormal.Deployed.Poseidon2Link

open Shieldd.GnarkFormal.Poseidon2Bridge
open Shieldd.GnarkFormal.Extracted.Poseidon2 (F Order)

variable [Fact (Nat.Prime Order)]

def row3 (m0 m1 m2 w0 w1 w2 : F) : F :=
  m0 * w0 + m1 * w1 + m2 * w2

theorem fr_eq3 (prev cs : List.Vector F 3) (w0 w1 w2 : F)
    (h0 : w0 = p17 (prev[0] + cs[0]))
    (h1 : w1 = p17 (prev[1] + cs[1]))
    (h2 : w2 = p17 (prev[2] + cs[2])) :
    fr3 prev cs = vec![
      row3 (5629641166285580282832549959187697687583932890102709218623488970611606159361 : F)
        (6333346312071277818186618704086159898531924501365547870951425091938056929281 : F)
        (6755569399542696339399059951025237225100719468123251062348186764733927391233 : F)
        w0 w1 w2,
      row3 (6333346312071277818186618704086159898531924501365547870951425091938056929281 : F)
        (6755569399542696339399059951025237225100719468123251062348186764733927391233 : F)
        (7037051457856975353540687448984622109479916112628386523279361213264507699201 : F)
        w0 w1 w2,
      row3 (6755569399542696339399059951025237225100719468123251062348186764733927391233 : F)
        (7037051457856975353540687448984622109479916112628386523279361213264507699201 : F)
        (7238110070938603220784707090384182741179342287274911852515914390786350776321 : F)
        w0 w1 w2] := by
  subst h0 h1 h2
  rfl

theorem pr_eq3 (prev cs : List.Vector F 3) (w0 : F)
    (h0 : w0 = p17 (prev[0] + cs[0])) :
    pr3 prev cs = vec![
      row3 (5629641166285580282832549959187697687583932890102709218623488970611606159361 : F)
        (6333346312071277818186618704086159898531924501365547870951425091938056929281 : F)
        (6755569399542696339399059951025237225100719468123251062348186764733927391233 : F)
        w0 (prev[1] + cs[1]) (prev[2] + cs[2]),
      row3 (6333346312071277818186618704086159898531924501365547870951425091938056929281 : F)
        (6755569399542696339399059951025237225100719468123251062348186764733927391233 : F)
        (7037051457856975353540687448984622109479916112628386523279361213264507699201 : F)
        w0 (prev[1] + cs[1]) (prev[2] + cs[2]),
      row3 (6755569399542696339399059951025237225100719468123251062348186764733927391233 : F)
        (7037051457856975353540687448984622109479916112628386523279361213264507699201 : F)
        (7238110070938603220784707090384182741179342287274911852515914390786350776321 : F)
        w0 (prev[1] + cs[1]) (prev[2] + cs[2])] := by
  subst h0
  rfl

end Shieldd.GnarkFormal.Deployed.Poseidon2Link
