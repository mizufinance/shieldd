private theorem map_take
    {α β : Type} {width count : Nat}
    (value : List.Vector α width) (f : α → β) :
    (value.map f).take count = (value.take count).map f := by
  apply List.Vector.eq
  simp [List.map_take]

private theorem map_drop
    {α β : Type} {width : Nat}
    (value : List.Vector α width) (f : α → β) (count : Nat) :
    (value.map f).drop count = (value.drop count).map f := by
  apply List.Vector.eq
  simp [List.map_drop]

private theorem canon1Bits_take_248 (rho : Nat → F) :
    (canon1Bits rho).take 248 =
      List.Vector.ofFn (fun i : Fin 248 => rho (710 + i.val)) := by
  rfl

private theorem canon1Bits_drop_248 (rho : Nat → F) :
    (canon1Bits rho).drop 248 =
      List.Vector.ofFn (fun i : Fin 5 => rho (958 + i.val)) := by
  rfl

private theorem canon2Bits_take_240 (rho : Nat → F) :
