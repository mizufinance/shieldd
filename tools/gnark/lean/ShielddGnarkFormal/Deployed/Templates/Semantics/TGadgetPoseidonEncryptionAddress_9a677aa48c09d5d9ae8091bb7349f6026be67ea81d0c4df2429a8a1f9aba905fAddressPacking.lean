private theorem plaintext0_eq_recover (rho : Nat → F) :
    plaintext0 rho =
      recover_binary_zmod' ((canon1Bits rho).take 248) := by
  rw [canon1Bits_take_248]
  unfold plaintext0
  simp (config := { maxSteps := 1000000 }) [recover_binary_zmod']
  ring

private theorem plaintext1_eq_recover (rho : Nat → F) :
    plaintext1 rho =
      recover_binary_zmod' ((canon1Bits rho).drop 248) +
        (2 ^ 8 : F) *
          recover_binary_zmod' ((canon2Bits rho).take 240) := by
  rw [canon1Bits_drop_248, canon2Bits_take_240]
  unfold plaintext1
  simp (config := { maxSteps := 1000000 }) [recover_binary_zmod']
  ring

