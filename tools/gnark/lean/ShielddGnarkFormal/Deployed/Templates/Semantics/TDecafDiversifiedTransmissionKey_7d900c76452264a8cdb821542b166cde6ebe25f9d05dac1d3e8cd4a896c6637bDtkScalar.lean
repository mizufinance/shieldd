theorem dtk_scalar_ladder (rho : Nat -> F) (h : Shieldd.GnarkFormal.Deployed.Templates.Relations.TDecafDiversifiedTransmissionKey_7d900c76452264a8cdb821542b166cde6ebe25f9d05dac1d3e8cd4a896c6637b.relation rho)
    (bits : List.Vector Bool 251)
    (hbits : dtkScalarBits rho = bits.map Bool.toZMod)
    (hdiv : onCurveAt (rho 2211) (rho 2213)) :
    Shieldd.GnarkFormal.DtkBridge.dtkLadderK (dtkScalarBits rho)
      (Shieldd.GnarkFormal.ScalarMulBridge.finalKWithOutputCurve
        (dtkOutX rho : F) (dtkOutY rho : F))
      251 0 ⟨0, 1⟩ ⟨(rho 2211 : F), (rho 2213 : F)⟩ := by
  have hbitAt : ∀ i, i < 251 → rho (983 + i) = Bool.toZMod bits[i]! := by
    intro i hi
    rw [← dtkScalarBits_get rho i hi, hbits]
    rw [getElem!_pos (bits.map Bool.toZMod) i (by simpa using hi), getElem!_pos bits i (by simpa using hi), List.Vector.getElem_map]
  have hstep : ∀ i, i < 251 →
      EdwardsBridge.onCurve (dtkLadderAccState rho i) →
      EdwardsBridge.onCurve (dtkLadderCurState rho i) →
      Shieldd.GnarkFormal.ScalarMulBridge.StepRel (Bool.toZMod bits[i]!)
        (dtkLadderAccState rho i) (dtkLadderCurState rho i)
        (dtkLadderAccState rho (i + 1)) (dtkLadderCurState rho (i + 1)) := by
    intro i hi hacc hcur
    rcases Nat.lt_or_ge i 11 with hb0|hb0
    · exact dtk_hstep_c0 rho h bits hbitAt i (by omega) hb0 hacc hcur
    rcases Nat.lt_or_ge i 22 with hb1|hb1
    · exact dtk_hstep_c1 rho h bits hbitAt i hb0 hb1 hacc hcur
    rcases Nat.lt_or_ge i 33 with hb2|hb2
    · exact dtk_hstep_c2 rho h bits hbitAt i hb1 hb2 hacc hcur
    rcases Nat.lt_or_ge i 44 with hb3|hb3
    · exact dtk_hstep_c3 rho h bits hbitAt i hb2 hb3 hacc hcur
    rcases Nat.lt_or_ge i 55 with hb4|hb4
    · exact dtk_hstep_c4 rho h bits hbitAt i hb3 hb4 hacc hcur
    rcases Nat.lt_or_ge i 66 with hb5|hb5
    · exact dtk_hstep_c5 rho h bits hbitAt i hb4 hb5 hacc hcur
    rcases Nat.lt_or_ge i 77 with hb6|hb6
    · exact dtk_hstep_c6 rho h bits hbitAt i hb5 hb6 hacc hcur
    rcases Nat.lt_or_ge i 88 with hb7|hb7
    · exact dtk_hstep_c7 rho h bits hbitAt i hb6 hb7 hacc hcur
    rcases Nat.lt_or_ge i 99 with hb8|hb8
    · exact dtk_hstep_c8 rho h bits hbitAt i hb7 hb8 hacc hcur
    rcases Nat.lt_or_ge i 110 with hb9|hb9
    · exact dtk_hstep_c9 rho h bits hbitAt i hb8 hb9 hacc hcur
    rcases Nat.lt_or_ge i 121 with hb10|hb10
    · exact dtk_hstep_c10 rho h bits hbitAt i hb9 hb10 hacc hcur
    rcases Nat.lt_or_ge i 132 with hb11|hb11
    · exact dtk_hstep_c11 rho h bits hbitAt i hb10 hb11 hacc hcur
    rcases Nat.lt_or_ge i 143 with hb12|hb12
    · exact dtk_hstep_c12 rho h bits hbitAt i hb11 hb12 hacc hcur
    rcases Nat.lt_or_ge i 154 with hb13|hb13
    · exact dtk_hstep_c13 rho h bits hbitAt i hb12 hb13 hacc hcur
    rcases Nat.lt_or_ge i 165 with hb14|hb14
    · exact dtk_hstep_c14 rho h bits hbitAt i hb13 hb14 hacc hcur
    rcases Nat.lt_or_ge i 176 with hb15|hb15
    · exact dtk_hstep_c15 rho h bits hbitAt i hb14 hb15 hacc hcur
    rcases Nat.lt_or_ge i 187 with hb16|hb16
    · exact dtk_hstep_c16 rho h bits hbitAt i hb15 hb16 hacc hcur
    rcases Nat.lt_or_ge i 198 with hb17|hb17
    · exact dtk_hstep_c17 rho h bits hbitAt i hb16 hb17 hacc hcur
    rcases Nat.lt_or_ge i 209 with hb18|hb18
    · exact dtk_hstep_c18 rho h bits hbitAt i hb17 hb18 hacc hcur
    rcases Nat.lt_or_ge i 220 with hb19|hb19
    · exact dtk_hstep_c19 rho h bits hbitAt i hb18 hb19 hacc hcur
    rcases Nat.lt_or_ge i 231 with hb20|hb20
    · exact dtk_hstep_c20 rho h bits hbitAt i hb19 hb20 hacc hcur
    rcases Nat.lt_or_ge i 242 with hb21|hb21
    · exact dtk_hstep_c21 rho h bits hbitAt i hb20 hb21 hacc hcur
    exact dtk_hstep_c22 rho h bits hbitAt i hb21 hi hacc hcur
  have hfinal : EdwardsBridge.onCurve (dtkLadderAccState rho 251) →
      Shieldd.GnarkFormal.ScalarMulBridge.finalKWithOutputCurve
        (dtkOutX rho : F) (dtkOutY rho : F)
        vec![(dtkLadderAccState rho 251).x, (dtkLadderAccState rho 251).y,
          (dtkLadderCurState rho 251).x, (dtkLadderCurState rho 251).y] := by
    intro hacc
    unfold Shieldd.GnarkFormal.ScalarMulBridge.finalKWithOutputCurve GatesDef.eq
    refine ⟨rfl, rfl, ?_⟩
    apply Shieldd.GnarkFormal.Deployed.Dtk.outputCurveGates_of_onCurve
    have hacc' : EdwardsBridge.onCurve ⟨(dtkAccX251 rho : F), (dtkAccY251 rho : F)⟩ := hacc
    simpa only [dtkOutX, dtkOutY] using hacc'
  rw [hbits]
  apply Shieldd.GnarkFormal.Deployed.Dtk.stateTrace_to_dtkLadderK
    bits _ (dtkLadderAccState rho) (dtkLadderCurState rho) hstep hfinal 251 0 (by omega)
  · show EdwardsBridge.onCurve ⟨(dtkAccX0 rho : F), (dtkAccY0 rho : F)⟩
    simpa only [dtkAccX0, dtkAccY0] using EdwardsBridge.identity_onCurve
  · show EdwardsBridge.onCurve ⟨(rho 2211 : F), (rho 2213 : F)⟩
    simpa only [onCurveAt] using hdiv

