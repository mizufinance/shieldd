    (h0 : w0 = p17 (prev[0] + cs[0])) :
    pr4 prev cs = vec![
      row4 (6333346312071277818186618704086159898531924501365547870951425091938056929281:F) (6755569399542696339399059951025237225100719468123251062348186764733927391233:F) (7037051457856975353540687448984622109479916112628386523279361213264507699201:F) (7238110070938603220784707090384182741179342287274911852515914390786350776321:F) w0 (prev[1] + cs[1]) (prev[2] + cs[2]) (prev[3] + cs[3]),
