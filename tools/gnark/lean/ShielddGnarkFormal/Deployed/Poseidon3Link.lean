      row4 (7238110070938603220784707090384182741179342287274911852515914390786350776321:F) (7388904030749824121217721821433853214953911918259805849443329273927733084161:F) (4691367638571316902360458299323081406319944075085591015519574142176338466134:F) (7600015574485533381823942444903391878238309401638657445141710110325668315137:F) w0 (prev[1] + cs[1]) (prev[2] + cs[2]) (prev[3] + cs[3])] := by
