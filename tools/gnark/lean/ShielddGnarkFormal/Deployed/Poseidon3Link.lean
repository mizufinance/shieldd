import ShielddGnarkFormal.Poseidon3Bridge

/-! Reusable deployed-slice ⇒ `permSpec3` link for the width-4 (rate-3) Poseidon
class `gadget.nullifier`. Mirrors `Poseidon6Link` at width 4: each `fr4`/`pr4`
round becomes a flat MDS-of-wires vector given the reconstructed S-box wires, so a
deployed evaluator composes up to `permSpec3` round-by-round (CLAUDE ≤60-gate). -/

namespace Shieldd.GnarkFormal.Deployed.Poseidon3Link

open Shieldd.GnarkFormal.Poseidon3Bridge
open Shieldd.GnarkFormal.Extracted.Nullifier (F)

variable [Fact (Nat.Prime Shieldd.GnarkFormal.Extracted.Nullifier.Order)]

/-- Linear MDS row over four wires. -/
def row4 (m0 m1 m2 m3 w0 w1 w2 w3 : F) : F := m0*w0 + m1*w1 + m2*w2 + m3*w3

/-- Full round as a flat MDS-of-wires vector, given the 4 reconstructed S-box wires. -/
theorem fr_eq4 (prev cs : List.Vector F 4) (w0 w1 w2 w3 : F)
    (h0 : w0 = p17 (prev[0] + cs[0])) (h1 : w1 = p17 (prev[1] + cs[1]))
    (h2 : w2 = p17 (prev[2] + cs[2])) (h3 : w3 = p17 (prev[3] + cs[3])) :
    fr4 prev cs = vec![
      row4 (6333346312071277818186618704086159898531924501365547870951425091938056929281:F) (6755569399542696339399059951025237225100719468123251062348186764733927391233:F) (7037051457856975353540687448984622109479916112628386523279361213264507699201:F) (7238110070938603220784707090384182741179342287274911852515914390786350776321:F) w0 w1 w2 w3,
      row4 (6755569399542696339399059951025237225100719468123251062348186764733927391233:F) (7037051457856975353540687448984622109479916112628386523279361213264507699201:F) (7238110070938603220784707090384182741179342287274911852515914390786350776321:F) (7388904030749824121217721821433853214953911918259805849443329273927733084161:F) w0 w1 w2 w3,
