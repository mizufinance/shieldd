theorem power_surjective :
    ∀ m, 0 < m → m < fieldOrder →
      ∃ i < fieldOrder - 1, ((((22 : Nat) : ZMod fieldOrder) ^ i).val = m) :=
  generator_certificate.2

theorem generator_full_order :
    (((22 : Nat) : ZMod fieldOrder) ^ (fieldOrder - 1)) = 1 := by
  exact generator_certificate.1

/-- Choice-free Fermat theorem specialized to the certified Decaf377 field. -/
theorem fermat (a : ZMod fieldOrder) (ha : a ≠ 0) :
    a ^ (fieldOrder - 1) = 1 :=
  PrimeCertificate.pow_card_sub_one_eq_one_of_generator
    fieldOrder 22 one_lt generator_full_order power_surjective a ha

