def reducedStepOne (PrefixEqual: F) (Bit: F) (k: F -> Prop): Prop :=
    ∃gate_0, gate_0 = Gates.mul PrefixEqual Bit ∧
    k gate_0

def reducedStepZero (PrefixEqual: F) (Bit: F) (k: F -> Prop): Prop :=
    ∃gate_0, gate_0 = Gates.mul PrefixEqual Bit ∧
