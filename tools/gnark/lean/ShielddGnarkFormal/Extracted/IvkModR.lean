def ltConstStepZero (PrefixEqual: F) (Bit: F) (k: F -> Prop): Prop :=
    ∃gate_0, gate_0 = Gates.sub (1:F) Bit ∧
    ∃gate_1, gate_1 = Gates.mul PrefixEqual gate_0 ∧
    k gate_1

def ltConstStepOne (PrefixEqual: F) (IsLess: F) (Bit: F) (k: List.Vector F 2 -> Prop): Prop :=
    ∃gate_0, gate_0 = Gates.sub (1:F) Bit ∧
    ∃gate_1, gate_1 = Gates.mul PrefixEqual gate_0 ∧
    ∃gate_2, gate_2 = Gates.add IsLess gate_1 ∧
    ∃gate_3, gate_3 = Gates.mul IsLess gate_1 ∧
    ∃gate_4, gate_4 = Gates.sub gate_2 gate_3 ∧
    ∃gate_5, gate_5 = Gates.mul PrefixEqual Bit ∧
    k vec![gate_5, gate_4]

