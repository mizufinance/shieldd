# Pinned Hax/Aeneas/Lean toolchain for SnarkPack formal verification.
#
# trixie, not bookworm: the pinned `charon` release binary requires glibc 2.39
# and will not load on bookworm's 2.36 ("version `GLIBC_2.39' not found").
# charon-driver needs only 2.34 and aeneas is statically linked, so charon
# alone sets the floor. Any base substituted here must keep glibc >= 2.39.
FROM rust:1.89.0-trixie

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV ELAN_HOME=/usr/local/elan
ENV OPAMROOT=/usr/local/opam
ENV PATH="/usr/local/elan/bin:/usr/local/cargo/bin:/usr/local/opam/hax/bin:${PATH}"

# git-lfs is required to install the repository-local filters used while
# validating restored proof-artifact caches. Checkout itself never hydrates LFS.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git git-lfs jq libgmp-dev nodejs opam \
      pkg-config python3 rsync unzip xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && git lfs install --system

ARG JUST_VERSION=1.57.0
RUN cargo install --locked --version "${JUST_VERSION}" just

# Build elan from a reviewed commit, then install the exact Lean release.
ARG ELAN_COMMIT=3d5138e1526a569a23901b8ee559032793cf445e
ARG LEAN_VERSION=leanprover/lean4:v4.30.0
RUN cargo install --locked \
      --git https://github.com/leanprover/elan.git \
      --rev "${ELAN_COMMIT}" elan \
    && elan-init -y --no-modify-path --default-toolchain "${LEAN_VERSION}" \
    && rm -f /usr/local/cargo/bin/elan-init \
    && chmod -R a+rwX "${ELAN_HOME}"

# Use the pinned Hax repository's supported setup and Aeneas installer.
#
# The release archives are the provenance boundary: each is pinned by sha256,
# and AENEAS_COMMIT is cross-checked against hax's own pins.toml so our pin and
# hax's cannot silently diverge. The binaries themselves report no commit
# ("aeneas -version" prints "aeneas unknown"), so there is nothing to assert
# about them beyond that they run.
#
# charon ships three binaries: `charon` drives `charon-driver`, which is a rustc
# driver dynamically linked against librustc_driver from CHARON_TOOLCHAIN. All
# three must be installed, and that toolchain must carry rustc-dev; otherwise
# charon-driver cannot load and every extraction fails.
ARG HAX_COMMIT=c8e27c5945f7fc5791939cff7c1277f4ab768fe1
ARG AENEAS_COMMIT=e0a159645386230102a2bf89b4df2dcd2140777e
ARG AENEAS_ARCHIVE_SHA256=5a76680ce77737a5fe2ea3eb3750795bf3f3c13f0e3549d5dbd88e3fc191f2bd
ARG CHARON_ARCHIVE_SHA256=9ee9516044f25ef04d33016e71c9a05d9f92575c342e99300fff4b9109d67a48
ARG CHARON_TOOLCHAIN=nightly-2026-06-01
# `set -e` is load-bearing: the statements inside the install loop below are
# `;`-separated, so without it a failing guard would not stop the install.
RUN set -eux \
    && git clone --filter=blob:none https://github.com/cryspen/hax.git /opt/hax \
    && git -C /opt/hax checkout --detach "${HAX_COMMIT}" \
    && test "$(git -C /opt/hax rev-parse HEAD)" = "${HAX_COMMIT}" \
    && aeneas_short="$(printf '%s' "${AENEAS_COMMIT}" | cut -c1-7)" \
    && grep -Fq "commit = \"${aeneas_short}\"" /opt/hax/pins.toml \
    && curl -fL --retry 3 \
      -o /tmp/aeneas.tar.gz \
      https://github.com/cryspen/aeneas/releases/download/nightly-2026.07.01/aeneas-linux-x86_64.tar.gz \
    && echo "${AENEAS_ARCHIVE_SHA256}  /tmp/aeneas.tar.gz" | sha256sum -c - \
    && curl -fL --retry 3 \
      -o /tmp/charon.tar.gz \
      https://github.com/AeneasVerif/charon/releases/download/nightly-2026.07.01/charon-linux-x86_64.tar.gz \
    && echo "${CHARON_ARCHIVE_SHA256}  /tmp/charon.tar.gz" | sha256sum -c - \
    && mkdir /tmp/aeneas-unpack /tmp/charon-unpack \
    && tar -xzf /tmp/aeneas.tar.gz -C /tmp/aeneas-unpack \
    && tar -xzf /tmp/charon.tar.gz -C /tmp/charon-unpack \
    && for name in aeneas:/tmp/aeneas-unpack charon:/tmp/charon-unpack \
         charon-driver:/tmp/charon-unpack; do \
         bin_name="${name%%:*}"; \
         found="$(find "${name#*:}" -type f -name "${bin_name}")"; \
         test -n "${found}"; \
         test "$(printf '%s\n' "${found}" | wc -l)" -eq 1; \
         install -m 0755 "${found}" "${CARGO_HOME}/bin/${bin_name}"; \
       done \
    && rm -rf \
      /tmp/aeneas.tar.gz /tmp/aeneas-unpack \
      /tmp/charon.tar.gz /tmp/charon-unpack \
    && rustup toolchain install "${CHARON_TOOLCHAIN}" --profile minimal \
      --component rustc-dev --component llvm-tools-preview --component rust-src \
    && opam init --bare --disable-sandboxing -y \
    && opam switch create hax 5.1.1 -y \
    && eval "$(opam env --switch=hax --set-switch)" \
    && cd /opt/hax \
    && grep -Fq -- "--no-aeneas" ./setup.sh \
    && ./setup.sh -j 2 --no-aeneas \
    && rustup default 1.89.0 \
    && chmod -R a+rwX "${CARGO_HOME}" "${RUSTUP_HOME}" "${OPAMROOT}"

# Every assertion here must be satisfiable by the artifacts installed above.
# The charon translation at the end is the load-bearing one: it is the only
# check that actually loads charon-driver against the rustc-dev toolchain, and
# so the only one that would have caught the driver/toolchain being absent.
RUN set -eux; \
    test "$(rustc --version)" = "rustc 1.89.0 (29483883e 2025-08-04)"; \
    lean --version | grep -F "Lean (version 4.30.0"; \
    cargo hax --version | grep -F "${HAX_COMMIT}"; \
    cargo hax into --help | grep -F "aeneas-lean"; \
    cargo hax into aeneas-lean --help | grep -F -- "--lakefile"; \
    aeneas -version; \
    test "$(charon version)" = "0.1.218"; \
    test "$(charon toolchain-version)" = "${CHARON_TOOLCHAIN}"; \
    mkdir -p /tmp/charon-smoke/src; \
    cd /tmp/charon-smoke; \
    printf '[package]\nname = "smoke"\nversion = "0.0.0"\nedition = "2021"\n' \
      > Cargo.toml; \
    echo 'pub fn f(x: u32) -> u32 { x + 1 }' > src/lib.rs; \
    charon cargo --start-from crate; \
    test -s smoke.llbc; \
    cd /; rm -rf /tmp/charon-smoke; \
    python3 --version; git --version; git lfs version; rsync --version; just --version

CMD ["/bin/bash"]
