+    /// Attach non-verifiable prefix tombstones only after consuming/freezing the delta.
+    /// Point writes in these ranges and prefixes crossing substores are rejected.
+    /// The ordinary commit publishes a new snapshot and range invalidations atomically.
+    pub fn attach_nonverifiable_prefix_deletions(
+        &self, mut batch: StagedWriteBatch, prefixes: Vec<Vec<u8>>,
+    ) -> Result<StagedWriteBatch> {
+        ensure!(!batch.perform_migration, "range deletion is not a migration operation");
+        ensure!(batch.changes.nonverifiable_ranges.is_empty(), "maintenance already attached");
+        let mut changes = batch.changes.clone_changes();
+        let mut routed = Vec::new();
+        for prefix in prefixes {
+            ensure!(prefix.last() == Some(&b'/'), "maintenance prefix must end at a namespace delimiter");
+            let mut end = prefix.clone(); *end.last_mut().expect("nonempty prefix") = b'0';
+            let (start_key, config) = self.0.multistore_config.route_key_bytes(&prefix);
+            let (end_key, end_config) = self.0.multistore_config.route_key_bytes(&end);
+            ensure!(config == end_config && !start_key.is_empty(), "range crosses a substore boundary");
+            let mut probe = prefix.clone(); probe.push(0);
+            let (_, interior_config) = self.0.multistore_config.route_key_bytes(&probe);
+            ensure!(config == interior_config, "range starts at a substore boundary");
+            ensure!(!self.0.multistore_config.iter().any(|s| {
+                let p = s.prefix.as_bytes(); p >= prefix.as_slice() && p < end.as_slice()
+            }), "range contains a substore boundary");
+            ensure!(batch.changes.nonverifiable_changes.range(prefix.clone()..end.clone()).next().is_none(), "range overlaps a point write or deletion");
+            ensure!(!changes.nonverifiable_ranges.iter().any(|r| r.start < end && prefix < r.end), "overlapping maintenance ranges");
+            routed.push((config, start_key.to_vec(), end_key.to_vec()));
+            changes.nonverifiable_ranges.push(prefix..end);
+        }
+        for (config, start, end) in routed {
+            batch.write_batch.delete_range_cf(config.cf_nonverifiable(&self.0.db), start, end);
+        }
+        batch.changes = Arc::new(changes);
+        Ok(batch)
+    }
