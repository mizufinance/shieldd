+    /// Compact one already retired local namespace through the existing database owner.
+    /// The host schedules this blocking work under its maintenance concurrency/rate budget.
+    pub fn compact_nonverifiable_prefix(&self, prefix: &[u8]) -> Result<()> {
+        ensure!(prefix.last() == Some(&b'/'), "compaction prefix must end at namespace delimiter");
+        let mut end = prefix.to_vec(); *end.last_mut().expect("nonempty prefix") = b'0';
+        let (start, config) = self.0.multistore_config.route_key_bytes(prefix);
+        let (end, end_config) = self.0.multistore_config.route_key_bytes(&end);
+        ensure!(config == end_config, "compaction crosses substore boundary");
+        self.0.db.compact_range_cf(config.cf_nonverifiable(&self.0.db), Some(start), Some(end));
+        Ok(())
+    }
