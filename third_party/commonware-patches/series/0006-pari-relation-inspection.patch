+    #[test]
+    fn inspection_preserves_rows_and_private_witness_mapping() {
+        let (circuit, selected) = build::<Scalar>(|ctx| {
+            let x = Var::witness(ctx, |_| unreachable!("not evaluated"));
+            let y = Var::witness(ctx, |_| unreachable!("not evaluated"));
+            (x.clone() * &x).assert_eq(&y);
+            vec![x, y]
+        });
+        let layout = InputLayout::new(vec![selected[0]], vec![vec![selected[1]]]).unwrap();
+        let relation = compile(&circuit, &layout).unwrap();
+        assert_eq!(relation.constraints().len(), relation.rows.len());
+        for ((a, b), row) in relation.constraints().zip(&relation.rows) {
+            assert_eq!(a, row.squared);
+            assert_eq!(b, row.linear);
+        }
+        assert_eq!(relation.witness_column(0), Some(3));
+        assert_eq!(relation.witness_column(1), Some(4));
+        assert_eq!(relation.witness_column(2), None);
+    }
