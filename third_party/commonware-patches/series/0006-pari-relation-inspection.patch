+    /// Inspect canonical square rows without changing the selected input layout.
+    /// Each pair encodes `(A z)^2 = B z`; omitted padded rows are zero.
+    /// Column zero must equal one. This exposes constraints, not witness values.
+    pub fn constraints(
+        &self,
+    ) -> impl ExactSizeIterator<Item = (&[(u32, Scalar)], &[(u32, Scalar)])> {
+        self.rows
+            .iter()
+            .map(|row| (row.squared.as_slice(), row.linear.as_slice()))
+    }
+
+    /// Locate the private column allocated for an original circuit witness.
+    /// Public and committed aliases are linked by constraints and are not returned.
+    /// This is an index map, not a claim that an arbitrary assignment is honest.
+    pub fn witness_column(&self, witness: u32) -> Option<usize> {
+        self.value_sources
+            .iter()
+            .enumerate()
+            .skip(self.committed_start + self.committed_inputs())
+            .find_map(|(column, source)| match source {
+                ValueSource::Circuit(CircuitIdx::Witness(index)) if *index == witness => {
+                    Some(column)
+                }
+                _ => None,
+            })
+    }
