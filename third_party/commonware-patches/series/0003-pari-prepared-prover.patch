+/// Checked G1 bases prepared once for ordinary or combined MSMs.
+pub struct PreparedG1Msm {
+    affine: Vec<blst_p1_affine>,
+    indices: Vec<usize>,
+    segments: Vec<usize>,
+}
+impl PreparedG1Msm {
+    /// Inputs are checked group elements; identities stay implicit in the index map.
+    pub fn new(segments: &[&[G1]]) -> Self {
+        let mut pointers = Vec::new();
+        let mut indices = Vec::new();
+        for (i, point) in segments.iter().flat_map(|s| s.iter()).enumerate() {
+            if *point != G1::zero() {
+                indices.push(i);
+                pointers.push(&point.0 as *const blst_p1);
+            }
+        }
+        let mut affine = vec![blst_p1_affine::default(); pointers.len()];
+        if !pointers.is_empty() {
+            // SAFETY: pointers refer to live checked points, and output has exactly n entries.
+            unsafe { blst_p1s_to_affine(affine.as_mut_ptr(), pointers.as_ptr(), pointers.len()) };
+        }
+        Self {
+            affine,
+            indices,
+            segments: segments.iter().map(|s| s.len()).collect(),
+        }
+    }
+    pub fn resident_bytes(&self) -> usize {
+        self.affine.len() * core::mem::size_of::<blst_p1_affine>()
+            + (self.indices.len() + self.segments.len()) * core::mem::size_of::<usize>()
+    }
+    /// Short coefficient prefixes are zero-padded; bases never move or get copied per call.
+    pub fn msm(&self, scalars: &[&[Scalar]], strategy: &impl Strategy) -> Result<G1, &'static str> {
+        if scalars.len() != self.segments.len()
+            || scalars
+                .iter()
+                .zip(&self.segments)
+                .any(|(s, n)| s.len() > *n)
+        {
+            return Err("prepared MSM segment length mismatch");
+        }
+        if self.affine.is_empty() {
+            return Ok(G1::zero());
+        }
+        let mut bytes = Vec::with_capacity(32 * self.affine.len());
+        let mut selected = 0;
+        let mut offset = 0;
+        for (values, count) in scalars.iter().zip(&self.segments) {
+            while selected < self.indices.len() && self.indices[selected] < offset + count {
+                let index = self.indices[selected] - offset;
+                if let Some(value) = values.get(index) {
+                    bytes.extend_from_slice(&value.as_blst_scalar().b);
+                } else {
+                    bytes.extend_from_slice(&[0u8; 32]);
+                }
+                selected += 1;
+            }
+            offset += count;
+        }
+        debug_assert_eq!(bytes.len(), 32 * self.affine.len());
+        let manual = strategy.manual();
+        let workers = manual.parallelism();
+        Ok(if workers < 2 || self.affine.len() < MIN_PARALLEL_POINTS {
+            G1::msm_sequential(&self.affine, &bytes, SCALAR_BITS)
+        } else {
+            G1::msm_parallel(&self.affine, &bytes, SCALAR_BITS, workers, &manual)
+        })
+    }
+}
