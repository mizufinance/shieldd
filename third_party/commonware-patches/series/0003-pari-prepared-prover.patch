+#[cfg(test)]
+mod prepared_msm_tests {
+    use super::*;
+    use commonware_math::algebra::Random;
+    use commonware_parallel::{Rayon, Sequential};
+    use rand::{SeedableRng, rngs::StdRng};
+    use std::num::NonZeroUsize;
+
+    #[test]
+    fn prepared_msm_matches_generic_with_padding_and_identities() {
+        let mut rng = StdRng::seed_from_u64(9821);
+        let parallel = Rayon::new(NonZeroUsize::new(2).unwrap()).unwrap();
+        for size in [0, 1, 2, 16, 128] {
+            let mut a = (0..size)
+                .map(|_| G1::generator() * &Scalar::random(&mut rng))
+                .collect::<Vec<_>>();
+            let b = (0..size)
+                .map(|_| G1::generator() * &Scalar::random(&mut rng))
+                .collect::<Vec<_>>();
+            if size > 1 {
+                a[1] = G1::zero();
+            }
+            let prepared = PreparedG1Msm::new(&[&a, &[], &b]);
+            let x = (0..size)
+                .map(|_| Scalar::random(&mut rng))
+                .collect::<Vec<_>>();
+            let y = (0..size)
+                .map(|_| Scalar::random(&mut rng))
+                .collect::<Vec<_>>();
+            for used in [0, size / 2, size] {
+                let expected =
+                    G1::msm(&a[..used], &x[..used], &Sequential) + &G1::msm(&b, &y, &Sequential);
+                assert_eq!(
+                    prepared.msm(&[&x[..used], &[], &y], &Sequential).unwrap(),
+                    expected
+                );
+                assert_eq!(
+                    prepared.msm(&[&x[..used], &[], &y], &parallel).unwrap(),
+                    expected
+                );
+            }
+            assert_eq!(
+                prepared.msm(&[&[], &[], &[]], &parallel).unwrap(),
+                G1::zero()
+            );
+            assert!(prepared.msm(&[&x], &Sequential).is_err());
+            assert!(
+                prepared
+                    .msm(&[&vec![Scalar::one(); size + 1], &[], &y], &Sequential)
+                    .is_err()
+            );
+        }
+        let zeros = [G1::zero(); 4];
+        let prepared = PreparedG1Msm::new(&[&zeros]);
+        assert_eq!(
+            prepared.msm(&[&vec![Scalar::one(); 4]], &parallel).unwrap(),
+            G1::zero()
+        );
+    }
+}
