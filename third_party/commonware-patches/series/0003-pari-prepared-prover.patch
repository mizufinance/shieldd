+                    if column.iter().all(|v| *v == Scalar::zero()) {
+                        return Ok(Poly::zero());
+                    }
+                    Poly::from_coefficients(transform.interpolate(column, &Sequential)?)
+                        .ok_or(Error::TooLarge)
