+#[cfg(test)]
+mod relation_shape_tests {
+    use super::*;
+    use crate::zk::{circuit::{build, Var}, pari::{self, InputLayout, Relation}};
+    use commonware_parallel::Sequential;
+
+    #[test]
+    fn verifying_key_checks_relation_shape_beyond_its_digest_label() {
+        let (circuit, selected) = build(|ctx| {
+            let x = Var::witness(ctx, |_| Scalar::from(3));
+            vec![x.clone() * &x, x]
+        });
+        let layout = InputLayout::new(vec![selected[0]], vec![vec![selected[1]]]).unwrap();
+        let relation = Relation::compile(&circuit, &layout).unwrap();
+        let (_, key) = pari::setup(&relation, &mut <rand::rngs::StdRng as rand::SeedableRng>::seed_from_u64(0), &Sequential).unwrap();
+        assert!(key.matches_relation(&relation));
+        let mut changed = key.clone(); changed.domain_size *= 2;
+        assert!(!changed.matches_relation(&relation));
+        let mut changed = key.clone(); changed.blocks[0] += 1;
+        assert!(!changed.matches_relation(&relation));
+        let mut changed = key.clone(); changed.public_inputs += 1;
+        assert!(!changed.matches_relation(&relation));
+        let mut changed = key; changed.public_columns.swap(0, 1);
+        assert!(!changed.matches_relation(&relation));
+    }
+}
