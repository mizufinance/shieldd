# Normalize all text files to LF in both index and working tree.
# Rationale: bash scripts, Lean sources, and formal-verification metadata
# (hax-targets.txt etc.) are consumed by LF-assuming tools; autocrlf=true
# checkouts previously produced phantom gate failures (CR-contaminated
# `read -r` loops in check-snarkpack-invariants.sh).
# Specific overrides below take precedence (last match wins).
* text=auto eol=lf

# Windows batch files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.zst binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary
*.olean binary

# Only the current deployed proving material belongs in LFS. Keep these paths
# explicit so unrelated .bin/.sr1cs files and frontend assets stay in Git.
tools/gnark/artifacts/note_reshape1x8/note_reshape1x8.sr1cs filter=lfs diff=lfs merge=lfs -text
tools/gnark/artifacts/note_reshape1x8/proving_key.bin filter=lfs diff=lfs merge=lfs -text
tools/gnark/artifacts/note_reshape8x1/note_reshape8x1.sr1cs filter=lfs diff=lfs merge=lfs -text
tools/gnark/artifacts/note_reshape8x1/proving_key.bin filter=lfs diff=lfs merge=lfs -text
tools/gnark/artifacts/shielded_ics20_withdrawal/shielded_ics20_withdrawal.sr1cs filter=lfs diff=lfs merge=lfs -text
tools/gnark/artifacts/shielded_ics20_withdrawal/proving_key.bin filter=lfs diff=lfs merge=lfs -text
tools/gnark/artifacts/transfer/transfer.sr1cs filter=lfs diff=lfs merge=lfs -text
tools/gnark/artifacts/transfer/proving_key.bin filter=lfs diff=lfs merge=lfs -text


# Collapse generated circuit adapters while keeping handwritten Lean proofs
# visible in GitHub review.
tools/gnark/lean/ShielddGnarkFormal/Deployed/**/*.lean linguist-generated=true
tools/gnark/lean/ShielddGnarkFormal/Deployed/*.lean linguist-generated=false
tools/gnark/lean/ShielddGnarkFormal/Extracted/Deployed/**/*.lean linguist-generated=true
tools/gnark/lean/ShielddGnarkFormal/PrimeCertificates/Generated/**/*.lean linguist-generated=true
