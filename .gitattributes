# Normalize all text files to LF in both index and working tree.
# Rationale: bash scripts, Lean sources, and formal-verification metadata
# (hax-targets.txt etc.) are consumed by LF-assuming tools; autocrlf=true
# checkouts previously produced phantom gate failures (CR-contaminated
# `read -r` loops in check-snarkpack-invariants.sh).
# Specific overrides below take precedence (last match wins).
* text=auto eol=lf

# Windows batch files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.zst binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary
*.olean binary

# Git LFS (pre-existing rules).
*.bin filter=lfs diff=lfs merge=lfs -text
*.sr1cs filter=lfs diff=lfs merge=lfs -text
assets/** filter=lfs diff=lfs merge=lfs -text

# Lean proof tree: mostly machine-generated adapters; collapse in GitHub PR review
tools/gnark/lean/ShielddGnarkFormal/**/*.lean linguist-generated=true
