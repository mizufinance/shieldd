theory ComplianceCiphertextActive
begin

/*
  STATUS: VERIFIED. All four lemmas (DLEQ_BINDING, REPLAY_RESISTANCE,
  NO_KEY_CONFUSION, EXECUTABLE) verified by tamarin-prover 1.8.0 (maude 3.1)
  with all wellformedness checks passing. Re-prove with:
    tamarin-prover --prove compliance-active.spthy

  ============================================================================
  ASSUMPTIONS (what this proof rests on — read before trusting any lemma)
  ============================================================================
  1. DLEQ knowledge soundness is IMPORTED, not re-derived. The restriction
     `ProofSound` below asserts that any accepted proof was honestly generated
     for the identical (epk, s_point, metadata). This is exactly the Lean/VCVio
     result DLEQ-FS-KNOWLEDGE-SOUNDNESS (lean-dleq); Tamarin does not redo
     Schnorr algebra. Its residuals are CC-ASSUME-POSEIDON-RO and
     CC-ASSUME-DECAF377-PRIME-ORDER-GROUP.
  2. CONFIDENTIALITY IS OUT OF SCOPE here and is NOT proved by any lemma. The
     seed/plaintext is masked by a DH shared secret (ss = ack*epk,
     crypto.rs:258/347) and a Poseidon tier keystream (CC-ASSUME-POSEIDON-STREAM).
     Because s_point = r*ACK is PUBLISHED (crypto.rs:195), s_point secrecy is
     false by construction; a naive SECRECY lemma would be unsound, so none is
     asserted. Confidentiality stays a computational obligation carried by the
     assumption ledger + CC-ASSUME-POSEIDON-STREAM. This model proves
     INTEGRITY / BINDING only.
  3. The cryptographic transcript terms (mkproof/3, metadata/4) are free
     function symbols with no equational theory beyond pairing — i.e. proofs and
     metadata are opaque, collision-free constructors. The attacker can copy,
     replay, and recombine them but cannot forge new ones (that forging is what
     ProofSound rules out, per assumption 1).

  ----------------------------------------------------------------------------
  What this model adds over compliance.spthy
  ----------------------------------------------------------------------------
  compliance.spthy is closed-world: secrets never reach the attacker, so its
  lemmas hold by rule construction. Here the FULL published transcript
  (epk, s_point, proof, ciphertext, metadata) is sent to the Dolev-Yao attacker
  via Out(), and the attacker DRIVES verification via In(). This tests the one
  layer no other tool covers: unbounded-session replay and cross-tier /
  cross-transfer splicing of public artifacts.

  ----------------------------------------------------------------------------
  Faithfulness boundary (checked against crypto.rs)
  ----------------------------------------------------------------------------
  - compute_dleq_native / verify_dleq_native (crypto.rs:151-208): the DLEQ proves
    EPK = r*G and S = r*ACK share scalar r, bound to metadata M. Per
    crypto.rs:195 "S = r x ACK is provided by the prover alongside the proof" --
    so s_point IS public. The model publishes it; it is an opaque term here.
  - DLEQ *soundness* is the Lean result DLEQ-FS-KNOWLEDGE-SOUNDNESS. It is encoded
    as the restriction `ProofSound`: an accepted proof implies a prior honest
    generation for the identical (epk, s_point, metadata). Tamarin does not
    re-derive Schnorr algebra; the attacker may still replay/recombine honest
    proofs, which is what the binding/replay lemmas test.
  - metadata(policy, tier, salt, timestamp) is the binding context
    (compute_metadata_hash); tier in {'ack','dk'}.

  ----------------------------------------------------------------------------
  Explicitly OUT OF SCOPE for this model (do not add without a faithful submodel)
  ----------------------------------------------------------------------------
  Seed/plaintext CONFIDENTIALITY is NOT modeled here. The seed is masked by a DH
  shared secret (ss = ack*epk, crypto.rs:258/347) and the tier bytes by a
  Poseidon keystream (CC-ASSUME-POSEIDON-STREAM). Because s_point = r*ACK is
  published, a faithful secrecy model must rest confidentiality on the tier
  keystream / masking submodel, not on s_point secrecy. That submodel is not
  captured yet, so no SECRECY lemma is asserted here -- adding a naive one would
  be unsound. Confidentiality stays a computational obligation (ledger +
  Poseidon-stream assumption). This model covers integrity/binding only.
*/

functions:
    metadata/4,
    mkproof/3

/* ------------------------------------------------------------------------- *
 * Setup: live anchors and designated keys (ACK / DK).                        *
 * Public keys are published. Keys are minted from fresh secrets so a single  *
 * key cannot inhabit both domains.                                           *
 * ------------------------------------------------------------------------- */

rule SetupAnchor:
    [ Fr(~anchor) ]
  --[ LiveAnchorFact(~anchor) ]->
    [ !LiveAnchor(~anchor) ]

rule SetupAckKey:
    [ !LiveAnchor(anchor), Fr(~ack) ]
  --[ KeyInIMTFact(~ack, anchor), AckKey(~ack), DesignatedKey(~ack) ]->
    [ !KeyInIMT(~ack, anchor), Out(~ack) ]

rule SetupDkKey:
    [ !LiveAnchor(anchor), Fr(~dk) ]
  --[ KeyInIMTFact(~dk, anchor), DkKey(~dk), DesignatedKey(~dk) ]->
    [ !KeyInIMT(~dk, anchor), Out(~dk) ]

/* ------------------------------------------------------------------------- *
 * Honest encryption: publish the whole transcript. The attacker-controlled   *
 * (policy, timestamp) come in via In() to let it choose the binding context  *
 * within an honest run; salt and randomizer are fresh and secret.            *
 * ------------------------------------------------------------------------- */

rule EncryptTierAck:
    [ !KeyInIMT(ack, anchor), Fr(~r), Fr(~salt), In(<policy, ts>) ]
  --[ Encrypt(ack, anchor, metadata(policy, 'ack', ~salt, ts)),
      GenProof(<'epk', ~r>, <'s', ~r>, metadata(policy, 'ack', ~salt, ts)),
      MetadataBound(ack, 'ack', ~salt, ts) ]->
    [ Out(< <'epk', ~r>,
            <'s', ~r>,
            mkproof(<'epk', ~r>, <'s', ~r>, metadata(policy, 'ack', ~salt, ts)),
            metadata(policy, 'ack', ~salt, ts) >) ]

rule EncryptTierDk:
    [ !KeyInIMT(dk, anchor), Fr(~r), Fr(~salt), In(<policy, ts>) ]
  --[ Encrypt(dk, anchor, metadata(policy, 'dk', ~salt, ts)),
      GenProof(<'epk', ~r>, <'s', ~r>, metadata(policy, 'dk', ~salt, ts)),
      MetadataBound(dk, 'dk', ~salt, ts) ]->
    [ Out(< <'epk', ~r>,
            <'s', ~r>,
            mkproof(<'epk', ~r>, <'s', ~r>, metadata(policy, 'dk', ~salt, ts)),
            metadata(policy, 'dk', ~salt, ts) >) ]

/* ------------------------------------------------------------------------- *
 * Verification DRIVEN BY THE ATTACKER: it submits an arbitrary transcript.   *
 * Acceptance is gated by ProofSound (the Lean knowledge-soundness result).    *
 * ------------------------------------------------------------------------- */

rule VerifyRegulated:
    [ In(< epk, spt, mkproof(epk, spt, meta), meta >),
      !LiveAnchor(anchor) ]
  --[ Verify(epk, spt, meta, anchor),
      AcceptProof(epk, spt, meta),
      AnchorAccepted(anchor) ]->
    [ ]

/* ------------------------------------------------------------------------- *
 * Restriction: DLEQ knowledge soundness (proved in lean-dleq).               *
 * Any accepted proof was honestly generated for the identical statement and  *
 * metadata. The attacker may still replay/recombine GenProof outputs.        *
 * ------------------------------------------------------------------------- */

restriction ProofSound:
    "All epk spt meta #i.
        AcceptProof(epk, spt, meta) @ #i
        ==> (Ex #j. GenProof(epk, spt, meta) @ #j & #j < #i)"

/* ------------------------------------------------------------------------- *
 * Security lemmas (integrity / binding under an active attacker)             *
 * ------------------------------------------------------------------------- */

/* No cross-context splice: acceptance for a metadata tuple requires an honest
   generation under that EXACT (tier, salt, timestamp). Rules out lifting a proof
   across tier, salt, or timestamp. */
lemma DLEQ_BINDING:
    "All epk spt policy tier salt ts anchor #i.
        Verify(epk, spt, metadata(policy, tier, salt, ts), anchor) @ #i
        ==> (Ex #j. GenProof(epk, spt, metadata(policy, tier, salt, ts)) @ #j
                    & #j < #i)"

/* Replay resistance: acceptance requires a live anchor established earlier. */
lemma REPLAY_RESISTANCE:
    "All epk spt meta anchor #i.
        Verify(epk, spt, meta, anchor) @ #i
        ==> (Ex #j. LiveAnchorFact(anchor) @ #j & #j < #i)"

/* Key-domain separation: no key is minted as both ACK and DK. */
lemma NO_KEY_CONFUSION:
    "not (Ex key #i #j. AckKey(key) @ #i & DkKey(key) @ #j)"

/* Executability: an honest transcript verifies end to end. */
lemma EXECUTABLE:
    exists-trace
    "Ex epk spt meta anchor #i #j.
        GenProof(epk, spt, meta) @ #i
      & Verify(epk, spt, meta, anchor) @ #j
      & #i < #j"

end
