theory ComplianceCiphertext
begin

builtins: diffie-hellman, hashing

functions: dem/2, dleq/3, imt_member/2, imt_gap/2, metadata/4

/*
  Symbolic model boundary:
  - DH, DLEQ, DEM/Poseidon stream, IMT membership/gap checks, point compression,
    and regulated/unregulated classification are idealized.
  - The corresponding computational and representation assumptions remain in
    assumption-ledger.md and are cited by proved-symbolic ledger rows.
  - RULE_VerifyUnregulated encodes the fixed Phase-0 semantics: unregulated
    acceptance is a sink-key path, not issuer decryptability.
*/

rule FACT_LiveAnchor:
  [ Fr(~anchor) ]
  --[ LiveAnchorFact(~anchor) ]->
  [ !LiveAnchor(~anchor) ]

rule FACT_AckKeyInIMT:
  [ !LiveAnchor(anchor), Fr(~key) ]
  --[ KeyInIMTFact(~key, anchor), AckKey(~key), DesignatedKey(~key) ]->
  [ !KeyInIMT(~key, anchor), !DesignatedAck(~key) ]

rule FACT_DkKeyInIMT:
  [ !LiveAnchor(anchor), Fr(~key) ]
  --[ KeyInIMTFact(~key, anchor), DkKey(~key), DesignatedKey(~key) ]->
  [ !KeyInIMT(~key, anchor), !DesignatedDk(~key) ]

rule RULE_EncryptTierAck:
  [ !KeyInIMT(key, anchor), !DesignatedAck(key), Fr(~seed) ]
  --[
    EncryptTier(~seed, key, anchor),
    DleqBound(key, ~seed),
    MetadataBound(key, 'ack')
  ]->
  [ TierCipher(~seed, key, anchor), DemCipher(dem(~seed, 'ack')) ]

rule RULE_EncryptTierDk:
  [ !KeyInIMT(key, anchor), !DesignatedDk(key), Fr(~seed) ]
  --[
    EncryptTier(~seed, key, anchor),
    DleqBound(key, ~seed),
    MetadataBound(key, 'dk')
  ]->
  [ TierCipher(~seed, key, anchor), DemCipher(dem(~seed, 'dk')) ]

rule RULE_VerifyRegulated:
  [ TierCipher(seed, key, anchor), !LiveAnchor(anchor), !KeyInIMT(key, anchor) ]
  --[
    VerifyRegulated(seed, key, anchor),
    DetectionAccepted(seed),
    AnchorAccepted(anchor)
  ]->
  [ Accepted(seed, key, anchor) ]

rule RULE_VerifyUnregulated:
  [ !LiveAnchor(anchor), Fr(~sink) ]
  --[
    VerifyUnregulated(~sink, anchor),
    SinkKey(~sink),
    AnchorAccepted(anchor)
  ]->
  [ AcceptedUnregulated(~sink, anchor) ]

rule RULE_DecodeDesignatedAck:
  [ TierCipher(seed, key, anchor), !DesignatedAck(key) ]
  --[
    PlaintextRecovered(seed, key),
    DesignatedDecrypt(key),
    DecodeAck(key)
  ]->
  [ ]

rule RULE_DecodeDesignatedDk:
  [ TierCipher(seed, key, anchor), !DesignatedDk(key) ]
  --[
    PlaintextRecovered(seed, key),
    DesignatedDecrypt(key),
    DecodeDk(key)
  ]->
  [ ]

lemma SECRECY:
  "All seed key #i.
    PlaintextRecovered(seed, key) @ #i ==> DesignatedDecrypt(key) @ #i"

lemma DETECTION_CORRECTNESS:
  "All seed key anchor #i.
    VerifyRegulated(seed, key, anchor) @ #i ==> DetectionAccepted(seed) @ #i"

lemma DESIGNATED_DECRYPTABILITY:
  "All seed key #i.
    PlaintextRecovered(seed, key) @ #i
    ==> (Ex #j. DesignatedKey(key) @ #j & #j < #i)"

lemma DLEQ_BINDING:
  "All seed key anchor #i.
    VerifyRegulated(seed, key, anchor) @ #i
    ==> (Ex #j. DleqBound(key, seed) @ #j & #j < #i)"

lemma REPLAY_RESISTANCE:
  "All seed key anchor #i.
    VerifyRegulated(seed, key, anchor) @ #i
    ==> (Ex #j. LiveAnchorFact(anchor) @ #j & #j < #i)"

lemma NO_KEY_CONFUSION:
  "All key #i #j. AckKey(key) @ #i & DkKey(key) @ #j ==> F"

lemma ANCHOR_FRESHNESS:
  "All anchor #i.
    AnchorAccepted(anchor) @ #i
    ==> (Ex #j. LiveAnchorFact(anchor) @ #j & #j < #i)"

end
