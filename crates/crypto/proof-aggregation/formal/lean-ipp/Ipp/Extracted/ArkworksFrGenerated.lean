        let b2 ← s3_07_arkworks_fr_spike.sub b1 c1
        ok (cont (u2, v1, b2, c1))
      else
        let v2 ← s3_07_arkworks_fr_spike.sub_raw v1 u1
        let c2 ← s3_07_arkworks_fr_spike.sub c1 b1
        ok (cont (u1, v2, b1, c2))
    else
      ok (done (u, b, c))
  else
    ok (done (u, b, c))

/-- [ark_ip_proofs::s3_07_arkworks_fr_spike::inv]: loop 0 -/
def s3_07_arkworks_fr_spike.inv_loop0
  (one u v b c : MacCampaign.Array MacCampaign.U64 4#usize) :
  Result ((MacCampaign.Array MacCampaign.U64 4#usize) ×
    (MacCampaign.Array MacCampaign.U64 4#usize) ×
    (MacCampaign.Array MacCampaign.U64 4#usize)) := do
  loop
    (fun (u1, v1, b1, c1) =>
      s3_07_arkworks_fr_spike.inv_loop0.body one u1 v1 b1 c1)
    (u, v, b, c)

/-- [ark_ip_proofs::s3_07_arkworks_fr_spike::inv] -/
def s3_07_arkworks_fr_spike.inv
  (a : s3_07_arkworks_fr_spike.FrMont) :
  Result (Option s3_07_arkworks_fr_spike.FrMont) := do
  let zero := MacCampaign.Array.replicate 4#usize (MacCampaign.U64.ofNat 0)
  let isZero ← core.array.equality.PartialEqArray.eq core.cmp.PartialEqU64 a zero
  if isZero then
    ok none
  else
    let one := MacCampaign.Array.make 4#usize [
      MacCampaign.U64.ofNat 1, MacCampaign.U64.ofNat 0,
      MacCampaign.U64.ofNat 0, MacCampaign.U64.ofNat 0]
    let (u, b, c) ← s3_07_arkworks_fr_spike.inv_loop0 one a
      s3_07_arkworks_fr_spike.MODULUS s3_07_arkworks_fr_spike.R2 zero
    let uIsOne ← core.array.equality.PartialEqArray.eq core.cmp.PartialEqU64 u one
    if uIsOne then ok (some b) else ok (some c)

