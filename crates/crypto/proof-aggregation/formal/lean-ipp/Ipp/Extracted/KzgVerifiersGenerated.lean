-- Semantic definitions generated by Aeneas from the two scoped KZG equation kernels.
import Ipp.Extracted.AeneasRuntime

open Aeneas Aeneas.Std Result ControlFlow Error
open Std.Do
set_option linter.unusedVariables false
set_option maxHeartbeats 1000000
set_option maxRecDepth 2048

namespace ark_ip_proofs

structure core.ops.arith.Sub (Self : Type) (Rhs : Type) (Self_Output : Type)
  where
  sub : Self → Rhs → Result Self_Output

structure core.ops.arith.Mul (Self : Type) (Rhs : Type) (Self_Output : Type)
  where
  mul : Self → Rhs → Result Self_Output

structure core.ops.arith.Neg (Self : Type) (Self_Output : Type) where
  neg : Self → Result Self_Output

structure tipa.PairingEquation (Self : Type) (G1 : Type) (G2 : Type) where
  two_pairing_is_zero : G1 → G2 → G1 → G2 → Result Bool

def tipa.verify_commitment_key_g2_kzg_equation
  {F : Type} {G1 : Type} {G2 : Type} {E : Type} (corecloneCloneInst :
  core.clone.Clone F) (corecloneCloneInst1 : core.clone.Clone G1)
  (coreopsarithMulInst : core.ops.arith.Mul G1 F G1) (coreopsarithSubInst :
  core.ops.arith.Sub G1 G1 G1) (coreopsarithNegInst : core.ops.arith.Neg G1 G1)
  (corecloneCloneInst2 : core.clone.Clone G2) (coreopsarithMulInst1 :
  core.ops.arith.Mul G2 F G2) (coreopsarithSubInst1 : core.ops.arith.Sub G2 G2
  G2) (PairingEquationInst : tipa.PairingEquation E G1 G2) (g : G1)
  (g_beta : G1) (h : G2) (ck_final : G2) (ck_opening : G2) (eval : F)
  (z : F) : Result Bool := do
  let t ← corecloneCloneInst2.clone ck_final
  let t1 ← corecloneCloneInst2.clone h
  let t2 ← corecloneCloneInst.clone eval
  let t3 ← coreopsarithMulInst1.mul t1 t2
  let right_0 ← coreopsarithSubInst1.sub t t3
  let t4 ← corecloneCloneInst1.clone g_beta
  let t5 ← corecloneCloneInst1.clone g
  let t6 ← corecloneCloneInst.clone z
  let t7 ← coreopsarithMulInst.mul t5 t6
  let t8 ← coreopsarithSubInst.sub t4 t7
  let left_1 ← coreopsarithNegInst.neg t8
  let t9 ← corecloneCloneInst2.clone ck_opening
  PairingEquationInst.two_pairing_is_zero t5 right_0 left_1 t9

def tipa.verify_commitment_key_g1_kzg_equation
  {F : Type} {G1 : Type} {G2 : Type} {E : Type} (corecloneCloneInst :
  core.clone.Clone F) (corecloneCloneInst1 : core.clone.Clone G1)
  (coreopsarithMulInst : core.ops.arith.Mul G1 F G1) (coreopsarithSubInst :
  core.ops.arith.Sub G1 G1 G1) (coreopsarithNegInst : core.ops.arith.Neg G1 G1)
  (corecloneCloneInst2 : core.clone.Clone G2) (coreopsarithMulInst1 :
  core.ops.arith.Mul G2 F G2) (coreopsarithSubInst1 : core.ops.arith.Sub G2 G2
  G2) (PairingEquationInst : tipa.PairingEquation E G1 G2) (g : G1)
  (h_alpha : G2) (h : G2) (ck_final : G1) (ck_opening : G1) (eval : F)
  (z : F) : Result Bool := do
  let t ← corecloneCloneInst1.clone ck_final
  let t1 ← corecloneCloneInst1.clone g
  let t2 ← corecloneCloneInst.clone eval
  let t3 ← coreopsarithMulInst.mul t1 t2
  let left_0 ← coreopsarithSubInst.sub t t3
  let t4 ← corecloneCloneInst2.clone h_alpha
  let t5 ← corecloneCloneInst2.clone h
  let t6 ← corecloneCloneInst.clone z
  let t7 ← coreopsarithMulInst1.mul t5 t6
  let right_1 ← coreopsarithSubInst1.sub t4 t7
  let t8 ← corecloneCloneInst1.clone ck_opening
  let t9 ← coreopsarithNegInst.neg t8
  PairingEquationInst.two_pairing_is_zero left_0 t5 t9 right_1

end ark_ip_proofs
