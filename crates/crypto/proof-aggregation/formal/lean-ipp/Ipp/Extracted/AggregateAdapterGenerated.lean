def applications.groth16_aggregation.validate_aggregate_proof_data
  {G1 : Type} {G2 : Type} {GT : Type} {D : Type}
  (ark_serializeCanonicalSerializeInst : ark_serialize.CanonicalSerialize G1)
  (ark_serializeCanonicalDeserializeInst : ark_serialize.CanonicalDeserialize
  G1) (corecloneCloneInst : core.clone.Clone G1) (coredefaultDefaultInst :
  core.default.Default G1) (corecmpEqInst : core.cmp.Eq G1)
  (ark_serializeCanonicalSerializeInst1 : ark_serialize.CanonicalSerialize G2)
  (ark_serializeCanonicalDeserializeInst1 : ark_serialize.CanonicalDeserialize
  G2) (corecloneCloneInst1 : core.clone.Clone G2)
  (ark_serializeCanonicalSerializeInst2 : ark_serialize.CanonicalSerialize GT)
  (ark_serializeCanonicalDeserializeInst2 : ark_serialize.CanonicalDeserialize
  GT) (corecloneCloneInst2 : core.clone.Clone GT) (coredefaultDefaultInst1 :
  core.default.Default GT) (corecmpEqInst1 : core.cmp.Eq GT)
  (proof : applications.groth16_aggregation.AggregateProofData G1 G2 GT
  (ark_dh_commitments.identity.IdentityOutput GT)
  (ark_dh_commitments.identity.IdentityOutput G1) D) :
  Result (core.result.Result
    (applications.groth16_aggregation.ValidatedAggregateProofData G1 G2 GT D)
    applications.groth16_aggregation.AggregateProofShapeError)
  := do
  let t ← corecloneCloneInst2.clone proof.com_a
  let t1 ← corecloneCloneInst2.clone proof.com_b
  let t2 ← corecloneCloneInst2.clone proof.com_c
  let t3 ← corecloneCloneInst2.clone proof.ip_ab
  let t4 ← corecloneCloneInst.clone proof.agg_c
  let r ←
    applications.groth16_aggregation.shipping_tipp_mipp_core_proof
      ark_serializeCanonicalSerializeInst ark_serializeCanonicalDeserializeInst
      corecloneCloneInst coredefaultDefaultInst corecmpEqInst
      ark_serializeCanonicalSerializeInst1
      ark_serializeCanonicalDeserializeInst1 corecloneCloneInst1
      ark_serializeCanonicalSerializeInst2
      ark_serializeCanonicalDeserializeInst2 corecloneCloneInst2
      coredefaultDefaultInst1 corecmpEqInst1 proof
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    ok (core.result.Result.Ok
      {
        com_a := t,
        com_b := t1,
        com_c := t2,
        ip_ab := t3,
        agg_c := t4,
        tipp_mipp_proof := val,
        _digest := ()
      })
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
      (applications.groth16_aggregation.ValidatedAggregateProofData G1 G2 GT D)
      (core.convert.FromSame
      applications.groth16_aggregation.AggregateProofShapeError) residual
