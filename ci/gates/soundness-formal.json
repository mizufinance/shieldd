{
  "schema_version": 1,
  "gate": "soundness-formal",
  "tiers": [
    "skip",
    "stamps",
    "full"
  ],
  "events": {
    "pull_request": {
      "conservative_tier": "stamps"
    },
    "merge_group": {
      "conservative_tier": "full"
    },
    "schedule": {
      "tier": "full"
    },
    "workflow_call": {
      "tier": "full"
    },
    "workflow_dispatch": {
      "tier": "full"
    }
  },
  "derived_inputs": [
    {
      "type": "cargo_local_closure",
      "packages": [
        "shieldd-constraint-coverage",
        "shieldd-sdk-compliance",
        "shieldd-sdk-shielded-pool"
      ],
      "tiers": {
        "pull_request": "stamps",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "local Cargo dependency closure for soundness seams and constraint coverage"
    }
  ],
  "explicit_inputs": [
    {
      "patterns": [
        ".cargo/config.toml",
        ".github/actions/setup-nix-rust/**",
        ".github/workflows/fv-toolchain-image.yml",
        ".github/workflows/formal-scheduled.yml",
        ".github/workflows/formal.yml",
        ".github/workflows/soundness-provers.yml",
        "Cargo.lock",
        "Cargo.toml",
        "ci/gates/soundness-formal.json",
        "flake.lock",
        "flake.nix",
        "rust-toolchain.toml",
        "scripts/ci/gate-applicability.py",
        "scripts/ci/test_gate_applicability.py"
      ],
      "tiers": {
        "pull_request": "stamps",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "workspace, toolchain, image, workflow, or classifier input"
    },
    {
      "patterns": [
        ".gitignore",
        "crates/core/component/compliance/formal/**",
        "crates/core/component/shielded-pool/formal/**",
        "crates/core/component/shielded-pool/proofs/fstar/**",
        "docs/soundness/**",
        "scripts/check-constraint-coverage.sh",
        "scripts/check-lean-circuit-fv.sh",
        "scripts/check-manifest-pin.sh",
        "scripts/check-soundness-invariants.sh",
        "scripts/check-structured-lc-lint.sh",
        "scripts/check-vk-derivation.sh",
        "scripts/circuit-constraint-check.sh",
        "scripts/circuit-gadget-proof-check.sh",
        "scripts/compliance-alloy.sh",
        "scripts/compliance-lean-dleq.sh",
        "scripts/compliance-symbolic.sh",
        "scripts/lint-emitted-lean.py",
        "scripts/run-picus-bounded.sh",
        "scripts/run-whole-circuit-picus.sh",
        "scripts/shielded-pool-formal.sh",
        "tools/gnark/**"
      ],
      "tiers": {
        "pull_request": "stamps",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "soundness proof, artifact, generator, runtime, or invoked gate input"
    },
    {
      "patterns": [
        "tools/proto-compiler/**"
      ],
      "tiers": {
        "pull_request": "stamps",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "protobuf code generator can alter generated Rust inputs in the soundness Cargo closure"
    }
  ],
  "irrelevant_inputs": [
    {
      "patterns": [
        "scripts/lib/common.sh",
        "scripts/orbis-ci-cleanup.sh",
        "scripts/orbis-integration-preflight.sh",
        "scripts/orbis-stack.sh",
        "scripts/shieldd-down.sh",
        "scripts/shieldd-up.sh"
      ],
      "reason": "Orbis and local stack orchestration is outside the circuit soundness contract"
    },
    {
      "patterns": [
        ".github/ISSUE_TEMPLATE/**",
        ".github/**",
        ".config/**",
        ".envrc.example",
        "AGENTS.md",
        "CLAUDE.md",
        "LICENSE",
        "LICENSE-*",
        "README.md",
        "assets/**",
        "ci/**",
        "clippy.toml",
        "deny.toml",
        "deployments/**",
        "dist-workspace.toml",
        "docs/**",
        "poc/**",
        "proto/**",
        "testnets/**"
      ],
      "reason": "audited non-runtime path outside the declared soundness contract"
    }
  ]
}
