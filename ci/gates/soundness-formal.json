{
  "schema_version": 1,
  "gate": "soundness-formal",
  "tiers": [
    "skip",
    "stamps",
    "typed",
    "full"
  ],
  "events": {
    "pull_request": {
      "conservative_tier": "stamps"
    },
    "merge_group": {
      "conservative_tier": "full"
    },
    "schedule": {
      "tier": "full"
    },
    "workflow_call": {
      "tier": "full"
    },
    "workflow_dispatch": {
      "tier": "full"
    }
  },
  "derived_inputs": [
    {
      "type": "cargo_local_closure",
      "packages": [
        "pd",
        "shieldd",
        "shieldd-constraint-coverage",
        "shieldd-sdk-app",
        "shieldd-sdk-compliance",
        "shieldd-sdk-shielded-pool",
        "shieldd-sdk-transaction",
        "shieldd-sdk-view"
      ],
      "tiers": {
        "pull_request": "stamps",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "local Cargo dependency closure for deployed ABCI/host front doors, circuit, transaction, view construction, consensus execution, and constraint coverage seams"
    }
  ],
  "explicit_inputs": [
    {
      "patterns": [
        "scripts/fv_certification.py",
        "tools/gnark/fv_certification_backends.json",
        "tools/gnark/fv_profiles.json",
        "tools/gnark/lean/ShielddGnarkFormal/Protocol/Common.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Protocol/NoteReshape/**",
        "tools/gnark/lean/ShielddGnarkFormal/Protocol/Transfer/**",
        "tools/gnark/lean/ShielddGnarkFormal/Protocol/ShieldedIcs20Withdrawal/**",
        "tools/gnark/lean/ShielddGnarkFormal/Poseidon1Spec.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Poseidon2Spec.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Poseidon3Spec.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Poseidon4Spec.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Poseidon6Spec.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Poseidon7Spec.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Poseidon377*",
        "tools/gnark/lean/ShielddGnarkFormal/Poseidon377/**",
        "tools/gnark/lean/ShielddGnarkFormal/ChoiceFreeZMod*",
        "tools/gnark/lean/ShielddGnarkFormal/NoteReshapeCanonical.lean",
        "tools/gnark/lean/ShielddGnarkFormal/*Bridge.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Deployed/NoteReshape*.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Deployed/Transfer*.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Deployed/ShieldedIcs20Withdrawal*.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Deployed/Generated/NoteReshape*.lean",
        "tools/gnark/lean/ShielddGnarkFormal/Deployed/Contracts/NoteReshape*/**",
        "tools/gnark/lean/ShielddGnarkFormal/Deployed/Contracts/Transfer/**",
        "tools/gnark/lean/ShielddGnarkFormal/Deployed/Contracts/ShieldedIcs20Withdrawal/**",
        "tools/gnark/lean/gen/**",
        "crates/core/component/shielded-pool/formal/certified-circuit-obligation-ledger.md"
      ],
      "tiers": {
        "pull_request": "typed",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "handwritten certified-circuit semantic or refinement source"
    },
    {
      "patterns": [
        ".cargo/config.toml",
        ".github/actions/setup-nix-rust/**",
        ".github/workflows/fv-toolchain-image.yml",
        ".github/workflows/formal.yml",
        ".github/workflows/formal-scheduled.yml",
        ".github/workflows/rust.yml",
        ".github/workflows/soundness-provers.yml",
        "Cargo.lock",
        "Cargo.toml",
        "ci/gates/soundness-formal.json",
        "flake.lock",
        "flake.nix",
        "rust-toolchain.toml",
        "scripts/ci/gate-applicability.py",
        "scripts/ci/test_gate_applicability.py"
      ],
      "tiers": {
        "pull_request": "stamps",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "workspace, toolchain, image, workflow, or classifier input"
    },
    {
      "patterns": [
        ".gitignore",
        "crates/core/app/src/action_handler/transaction.rs",
        "crates/core/app/src/action_handler/transaction/**",
        "crates/core/app/src/app/mod.rs",
        "crates/core/component/compliance/formal/**",
        "crates/core/component/shielded-pool/formal/**",
        "crates/core/component/shielded-pool/proofs/fstar/**",
        "docs/soundness/**",
        "scripts/check-constraint-coverage.sh",
        "scripts/check-circuit-fv.sh",
        "scripts/check-formal-gate-self-tests.sh",
        "scripts/check-fv-profiles.py",
        "scripts/check-fv-specification-evidence.sh",
        "scripts/check-fv-specification-completeness.py",
        "scripts/check-gadget-model-fidelity.sh",
        "scripts/check-lean-circuit-fv.sh",
        "scripts/check-manifest-pin.sh",
        "scripts/check-certified-circuit-impact.py",
        "scripts/check-certified-circuit-spec-independence.sh",
        "scripts/check-soundness-invariants.sh",
        "scripts/check-structured-lc-generation.sh",
        "scripts/check-structured-lc-lint.sh",
        "scripts/check-template-inventory.sh",
        "scripts/check-key-coherence.sh",
        "scripts/gen-certified-circuit-artifacts.py",
        "scripts/gen_fv_specification_matrix.py",
        "scripts/fv_specification_completeness.py",
        "scripts/run-fv-specification-tests.py",
        "scripts/sync-fv-certification-backends.py",
        "scripts/tests/test_*.py",
        "scripts/check_poseidon377_parity.sh",
        "scripts/circuit-constraint-check.sh",
        "scripts/circuit-gadget-proof-check.sh",
        "scripts/compliance-alloy.sh",
        "scripts/compliance-lean-dleq.sh",
        "scripts/compliance-symbolic.sh",
        "scripts/lib/fail-closed-rg.sh",
        "scripts/lint-emitted-lean.py",
        "scripts/run-picus-bounded.sh",
        "scripts/shielded-pool-formal.sh",
        "tools/gnark/**"
      ],
      "tiers": {
        "pull_request": "stamps",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "soundness proof, artifact, generator, runtime, or invoked gate input"
    }
  ],
  "irrelevant_inputs": [
    {
      "patterns": [
        ".github/ISSUE_TEMPLATE/**",
        "LICENSE",
        "LICENSE-*",
        "docs/**"
      ],
      "reason": "documentation-only path outside the declared soundness contract"
    }
  ]
}
