{
  "schema_version": 1,
  "gate": "orbis-integration",
  "tiers": [
    "skip",
    "full"
  ],
  "events": {
    "pull_request": {
      "conservative_tier": "full"
    },
    "merge_group": {
      "conservative_tier": "full"
    },
    "schedule": {
      "tier": "full"
    },
    "workflow_call": {
      "tier": "full"
    },
    "workflow_dispatch": {
      "tier": "full"
    }
  },
  "derived_inputs": [
    {
      "type": "cargo_local_closure",
      "packages": [
        "orbis-audit",
        "orbis-integration",
        "pcli",
        "pclientd",
        "pd"
      ],
      "tiers": {
        "default": "full"
      },
      "reason": "local Cargo dependency closure for every binary built or invoked by the Orbis flow"
    }
  ],
  "explicit_inputs": [
    {
      "patterns": [
        ".cargo/config.toml",
        ".github/actions/setup-nix-rust/**",
        ".github/workflows/orbis-integration.yml",
        "Cargo.lock",
        "Cargo.toml",
        "ci/gates/orbis-integration.json",
        "flake.lock",
        "flake.nix",
        "justfile",
        "rust-toolchain.toml",
        "scripts/ci/gate-applicability.py",
        "scripts/ci/test_gate_applicability.py"
      ],
      "tiers": {
        "default": "full"
      },
      "reason": "workspace, toolchain, environment, workflow, or classifier input"
    },
    {
      "patterns": [
        "compliance-docs/testing.md",
        "deployments/orbis/**",
        "scripts/lib/**",
        "scripts/orbis-*.sh",
        "scripts/shieldd-*.sh",
        "testnets/cometbft_config_template.toml",
        "testnets/validators-single.json",
        "tools/gnark/**"
      ],
      "tiers": {
        "default": "full"
      },
      "reason": "compose, testnet, container pin, generated proof, or invoked integration script"
    }
  ],
  "irrelevant_inputs": [
    {
      "patterns": [
        ".github/ISSUE_TEMPLATE/**",
        "LICENSE",
        "LICENSE-*",
        "docs/**"
      ],
      "reason": "documentation-only path outside the declared Orbis runtime contract"
    }
  ]
}
