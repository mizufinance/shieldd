{
  "schema_version": 1,
  "gate": "snarkpack-formal",
  "tiers": [
    "skip",
    "static",
    "extract-changed",
    "extract-all",
    "full"
  ],
  "events": {
    "pull_request": {
      "conservative_tier": "extract-all"
    },
    "merge_group": {
      "conservative_tier": "full"
    },
    "schedule": {
      "tier": "full"
    },
    "workflow_call": {
      "tier": "full"
    },
    "workflow_dispatch": {
      "tier": "full"
    }
  },
  "derived_inputs": [
    {
      "type": "cargo_local_closure",
      "packages": [
        "shieldd-sdk-proof-aggregation",
        "shieldd-sdk-proof-aggregation-fuzz",
        "shieldd-sdk-proof-aggregation-reference"
      ],
      "tiers": {
        "pull_request": "static",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "local Cargo dependency closure for SnarkPack implementation, fuzzing, and reference gates"
    },
    {
      "type": "lean_extraction_manifest",
      "path": "crates/crypto/proof-aggregation/formal/snarkpack/lean-extraction-manifest.json",
      "source_inventory": "crates/crypto/proof-aggregation/formal/lean-ipp/scripts/extractions.py",
      "global_inputs": [
        ".cargo/config.toml",
        "Cargo.lock",
        "Cargo.toml",
        "crates/crypto/proof-aggregation/formal/lean-ipp/Ipp/Extracted/AeneasRuntime.lean",
        "crates/crypto/proof-aggregation/formal/lean-ipp/scripts/extractions.py",
        "crates/crypto/proof-aggregation/formal/snarkpack/aeneas-toolchain.toml",
        "rust-toolchain.toml"
      ],
      "graph_tiers": {
        "pull_request": "extract-changed",
        "merge_group": "full",
        "default": "full"
      },
      "global_tiers": {
        "pull_request": "extract-all",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "SnarkPack proof extraction manifest"
    }
  ],
  "explicit_inputs": [
    {
      "patterns": [
        ".cargo/config.toml",
        ".gitattributes",
        "Cargo.lock",
        "Cargo.toml",
        "deployments/containerfiles/Dockerfile.snarkpack-fv-toolchain",
        "rust-toolchain.toml"
      ],
      "tiers": {
        "pull_request": "extract-all",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "workspace dependency or Rust toolchain input affects every extraction and parity graph"
    },
    {
      "patterns": [
        ".github/actions/**",
        ".github/workflows/**",
        "ci/gates/snarkpack-formal.json",
        "flake.lock",
        "flake.nix",
        "justfile",
        "scripts/check-snarkpack-invariants.sh",
        "scripts/check-snarkpack-filecoin-shape.sh",
        "scripts/check-snarkpack-runtime-invariants.sh",
        "scripts/ci/enforce_formal_result.py",
        "scripts/ci/gate-applicability.py",
        "scripts/ci/snarkpack_lane_fingerprint.py",
        "scripts/ci/test_snarkpack_lane_fingerprint.py",
        "scripts/ci/snarkpack_fv_impact.py",
        "scripts/ci/snarkpack_lean_attestation.py",
        "scripts/ci/test_enforce_formal_result.py",
        "scripts/ci/test_gate_applicability.py",
        "scripts/ci/test_snarkpack_fv_impact.py",
        "scripts/ci/test_snarkpack_lean_attestation.py",
        "scripts/ci/run_with_annotation.py",
        "scripts/ci/test_run_with_annotation.py",
        "scripts/fv_strict_json.py",
        "scripts/tests/test_fv_strict_json.py",
        "scripts/prepare_snarkpack_fstar_support.py",
        "scripts/snarkpack-lean-single-threaded.ps1",
        "scripts/run-snarkpack-fv-safe.ps1",
        "scripts/snarkpack-formal.sh",
        "scripts/snarkpack-fv.sh",
        "scripts/snarkpack-lean-conformance.sh"
      ],
      "tiers": {
        "pull_request": "static",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "workflow, classifier, diagnostic, or invoked gate implementation"
    },
    {
      "patterns": [
        "tools/proto-compiler/**"
      ],
      "tiers": {
        "pull_request": "static",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "protobuf code generator can alter generated Rust inputs in the SnarkPack Cargo closure"
    },
    {
      "patterns": [
        "crates/core/app/Cargo.toml",
        "crates/core/app/src/action_handler/actions.rs",
        "crates/core/app/src/app/mod.rs",
        "crates/core/app/src/app/preconsensus.rs",
        "crates/core/app/src/app/validation_support.rs",
        "crates/core/app/src/server/consensus.rs",
        "crates/core/app/src/stateless_cache.rs"
      ],
      "tiers": {
        "pull_request": "full",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "production application boundary that constructs, persists, orders, decodes, or dispatches SnarkPack shipping calls"
    },
    {
      "patterns": [
        "crates/crypto/proof-aggregation/formal/lean-ipp/Ipp/*.lean",
        "crates/crypto/proof-aggregation/formal/lean-ipp/*.lean",
        "crates/crypto/proof-aggregation/formal/lean-ipp/lake-manifest.json",
        "crates/crypto/proof-aggregation/formal/lean-ipp/lean-toolchain"
      ],
      "tiers": {
        "pull_request": "full",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "hand-written Lean specification, audit, dependency, or toolchain input requires a kernel build"
    },
    {
      "patterns": [
        "crates/bench/bench-thresholds.md",
        "crates/crypto/proof-aggregation/formal/**",
        "docs/snarkpack/**"
      ],
      "tiers": {
        "pull_request": "static",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "SnarkPack formal specification, invariant, or integration input"
    }
  ],
  "irrelevant_inputs": [
    {
      "patterns": [
        "scripts/check-certified-circuit-impact.py",
        "scripts/check-certified-circuit-spec-independence.sh",
        "scripts/check-circuit-fv.sh",
        "scripts/check-constraint-coverage.sh",
        "scripts/check-extracted-lean-heartbeats.sh",
        "scripts/check-formal-gate-self-tests.sh",
        "scripts/check-fv-census.sh",
        "scripts/check-fv-profiles.py",
        "scripts/check-fv-specification-completeness.py",
        "scripts/check-fv-specification-evidence.sh",
        "scripts/check-gadget-model-fidelity.sh",
        "scripts/check-key-coherence.sh",
        "scripts/check-lean-circuit-fv.sh",
        "scripts/check-manifest-pin.sh",
        "scripts/check-note-reshape-impact.py",
        "scripts/check-soundness-invariants.sh",
        "scripts/check-structured-lc-dtk-probes.sh",
        "scripts/check-structured-lc-generation.sh",
        "scripts/check-structured-lc-lint.sh",
        "scripts/check-template-inventory.sh",
        "scripts/check-vk-derivation.sh",
        "scripts/check_poseidon377_parity.sh",
        "scripts/circuit-constraint-check.sh",
        "scripts/circuit-gadget-proof-check.sh",
        "scripts/compliance-alloy.sh",
        "scripts/compliance-lean-dleq.sh",
        "scripts/compliance-symbolic.sh",
        "scripts/fixtures/**",
        "scripts/fv-census.py",
        "scripts/fv-json-field.py",
        "scripts/fv-opt-loop-diff.py",
        "scripts/fv-opt-loop.sh",
        "scripts/fv_certification.py",
        "scripts/fv_rust_evidence_classification.py",
        "scripts/fv_specification_completeness.py",
        "scripts/gen-certified-circuit-artifacts.py",
        "scripts/gen-edwards-precondition.py",
        "scripts/gen-note-reshape-family-artifacts.py",
        "scripts/gen_fv_specification_matrix.py",
        "scripts/lean-build-safe.sh",
        "scripts/lean-leaf-bench.sh",
        "scripts/linux-process-group-rss.py",
        "scripts/lib/fail-closed-rg.sh",
        "scripts/lib/soundness-symbol-cell.sh",
        "scripts/lint-emitted-lean.py",
        "scripts/macos-process-group-rss.c",
        "scripts/picus-diagnose.sh",
        "scripts/refresh-lean-artifact-stamps.py",
        "scripts/run-fv-specification-tests.py",
        "scripts/run-picus-bounded.sh",
        "scripts/run-whole-circuit-picus.sh",
        "scripts/shielded-pool-formal.sh",
        "scripts/sync-fv-certification-backends.py",
        "scripts/tests/test_check_certified_circuit_impact.py",
        "scripts/tests/test_check_constraint_coverage.py",
        "scripts/tests/test_check_fv_profiles.py",
        "scripts/tests/test_fv_rust_evidence_classification.py",
        "scripts/tests/test_fv_specification_completeness.py",
        "scripts/tests/test_gen_certified_circuit_artifacts.py",
        "scripts/tests/test_lean_build_safe.py",
        "scripts/tests/test_linux_process_group_rss.py",
        "scripts/tests/test_release_gate_strict_json.py",
        "scripts/tests/test_run_fv_specification_tests.py",
        "scripts/tests/test_soundness_symbol_cell.py",
        "scripts/tests/test_structured_lc_generation.py",
        "scripts/tests/test_wiring_certificates.py",
        "tools/gnark/**"
      ],
      "reason": "circuit soundness proof controls covered by the separate soundness family"
    },
    {
      "patterns": [
        "scripts/lib/common.sh",
        "scripts/orbis-ci-cleanup.sh",
        "scripts/orbis-integration-preflight.sh",
        "scripts/orbis-stack.sh",
        "scripts/shieldd-down.sh",
        "scripts/shieldd-up.sh"
      ],
      "reason": "Orbis and local stack orchestration is outside the SnarkPack implementation and proof contract"
    },
    {
      "patterns": [
        ".github/ISSUE_TEMPLATE/**",
        ".github/dependabot.yml",
        ".config/**",
        ".envrc.example",
        "AGENTS.md",
        "CLAUDE.md",
        ".gitignore",
        "LICENSE",
        "LICENSE-*",
        "README.md",
        "assets/**",
        "ci/**",
        "clippy.toml",
        "deny.toml",
        "deployments/**",
        "dist-workspace.toml",
        "docs/**",
        "poc/**",
        "proto/**",
        "testnets/**"
      ],
      "reason": "audited non-runtime path outside the declared SnarkPack contract"
    }
  ]
}
