{
  "schema_version": 1,
  "gate": "snarkpack-formal",
  "tiers": [
    "skip",
    "static",
    "extract-changed",
    "extract-all",
    "full"
  ],
  "events": {
    "pull_request": {
      "conservative_tier": "extract-all"
    },
    "merge_group": {
      "conservative_tier": "full"
    },
    "schedule": {
      "tier": "full"
    },
    "workflow_call": {
      "tier": "full"
    },
    "workflow_dispatch": {
      "tier": "full"
    }
  },
  "derived_inputs": [
    {
      "type": "cargo_local_closure",
      "packages": [
        "shieldd-sdk-proof-aggregation",
        "shieldd-sdk-proof-aggregation-fuzz",
        "shieldd-sdk-proof-aggregation-reference"
      ],
      "tiers": {
        "pull_request": "static",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "local Cargo dependency closure for SnarkPack implementation, fuzzing, and reference gates"
    },
    {
      "type": "lean_extraction_manifest",
      "path": "crates/crypto/proof-aggregation/formal/snarkpack/lean-extraction-manifest.json",
      "source_inventory": "crates/crypto/proof-aggregation/formal/lean-ipp/scripts/extractions.py",
      "global_inputs": [
        ".cargo/config.toml",
        "Cargo.lock",
        "Cargo.toml",
        "crates/crypto/proof-aggregation/formal/lean-ipp/Ipp/Extracted/AeneasRuntime.lean",
        "crates/crypto/proof-aggregation/formal/lean-ipp/scripts/extractions.py",
        "crates/crypto/proof-aggregation/formal/snarkpack/aeneas-toolchain.toml",
        "rust-toolchain.toml"
      ],
      "graph_tiers": {
        "pull_request": "extract-changed",
        "merge_group": "full",
        "default": "full"
      },
      "global_tiers": {
        "pull_request": "extract-all",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "SnarkPack proof extraction manifest"
    }
  ],
  "explicit_inputs": [
    {
      "patterns": [
        ".cargo/config.toml",
        "Cargo.lock",
        "Cargo.toml",
        "deployments/containerfiles/Dockerfile.snarkpack-fv-toolchain",
        "rust-toolchain.toml"
      ],
      "tiers": {
        "pull_request": "extract-all",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "workspace dependency or Rust toolchain input affects every extraction and parity graph"
    },
    {
      "patterns": [
        ".github/actions/**",
        ".github/workflows/**",
        "ci/gates/snarkpack-formal.json",
        "flake.lock",
        "flake.nix",
        "justfile",
        "scripts/check-snarkpack-invariants.sh",
        "scripts/check-snarkpack-runtime-invariants.sh",
        "scripts/ci/enforce_formal_result.py",
        "scripts/ci/gate-applicability.py",
        "scripts/ci/snarkpack_lane_fingerprint.py",
        "scripts/ci/test_snarkpack_lane_fingerprint.py",
        "scripts/ci/snarkpack_extraction_attestation.py",
        "scripts/ci/test_snarkpack_extraction_attestation.py",
        "scripts/ci/snarkpack_fv_impact.py",
        "scripts/ci/snarkpack_lean_attestation.py",
        "scripts/ci/test_enforce_formal_result.py",
        "scripts/ci/test_gate_applicability.py",
        "scripts/ci/test_snarkpack_fv_impact.py",
        "scripts/ci/test_snarkpack_lean_attestation.py",
        "scripts/ci/run_with_annotation.py",
        "scripts/ci/test_run_with_annotation.py",
        "scripts/prepare_snarkpack_fstar_support.py",
        "scripts/run-snarkpack-fv-safe.ps1",
        "scripts/snarkpack-formal.sh",
        "scripts/snarkpack-fv.sh"
      ],
      "tiers": {
        "pull_request": "static",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "workflow, classifier, diagnostic, or invoked gate implementation"
    },
    {
      "patterns": [
        "crates/core/app/Cargo.toml",
        "crates/core/app/src/action_handler/actions.rs",
        "crates/core/app/src/app/mod.rs",
        "crates/core/app/src/app/preconsensus.rs",
        "crates/core/app/src/app/validation_support.rs",
        "crates/core/app/src/server/consensus.rs",
        "crates/core/app/src/stateless_cache.rs"
      ],
      "tiers": {
        "pull_request": "full",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "production application boundary that constructs, persists, orders, decodes, or dispatches SnarkPack shipping calls"
    },
    {
      "patterns": [
        "crates/crypto/proof-aggregation/formal/lean-ipp/Ipp/*.lean",
        "crates/crypto/proof-aggregation/formal/lean-ipp/*.lean",
        "crates/crypto/proof-aggregation/formal/lean-ipp/lake-manifest.json",
        "crates/crypto/proof-aggregation/formal/lean-ipp/lean-toolchain"
      ],
      "tiers": {
        "pull_request": "full",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "hand-written Lean specification, audit, dependency, or toolchain input requires a kernel build"
    },
    {
      "patterns": [
        "crates/bench/bench-thresholds.md",
        "crates/crypto/proof-aggregation/formal/**",
        "docs/snarkpack/**"
      ],
      "tiers": {
        "pull_request": "static",
        "merge_group": "full",
        "default": "full"
      },
      "reason": "SnarkPack formal specification, invariant, or integration input"
    }
  ],
  "irrelevant_inputs": [
    {
      "patterns": [
        "scripts/lib/common.sh",
        "scripts/orbis-ci-cleanup.sh",
        "scripts/orbis-integration-preflight.sh",
        "scripts/orbis-stack.sh",
        "scripts/shieldd-down.sh",
        "scripts/shieldd-up.sh"
      ],
      "reason": "Orbis and local stack orchestration is outside the SnarkPack implementation and proof contract"
    },
    {
      "patterns": [
        ".github/ISSUE_TEMPLATE/**",
        ".config/**",
        ".envrc.example",
        "AGENTS.md",
        "CLAUDE.md",
        "LICENSE",
        "LICENSE-*",
        "README.md",
        "assets/**",
        "ci/**",
        "clippy.toml",
        "deny.toml",
        "deployments/**",
        "dist-workspace.toml",
        "docs/**",
        "poc/**",
        "testnets/**"
      ],
      "reason": "audited non-runtime path outside the declared SnarkPack contract"
    }
  ]
}
